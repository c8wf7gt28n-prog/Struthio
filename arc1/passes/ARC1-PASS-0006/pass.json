  "sensitive_changes": [
    {
      "path": "AGENTS.md",
      "kind": "modified",
      "justification": "Adds two rules: resource-budget figures must quote their source and are dropped otherwise (no estimated numbers to fill a chart), and the installer must stay standard-library-only and back up user-changed files on upgrade and uninstall. Nothing was relaxed."
    },
    {
      "path": "policy/protected_paths.json",
      "kind": "modified",
      "justification": "Adds hardware/budgets/* to the protected paths, so any later change to the cited budget figures must be disclosed like other hardware evidence. This tightens policy; nothing was removed."
    },
    {
      "path": "tests/test_r10_workbench.py",
      "kind": "modified",
      "justification": "Adds tests only: ResourceBudgetTests (every number is cited, a tampered quote drops the number, the agent returns the same data) and a Qt test of the Resources inspector. The one removed line is the import, which now also imports resources. No existing assertion was changed or removed."
    }
