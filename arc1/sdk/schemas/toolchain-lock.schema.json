{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc1.toolchain-lock/0.2",
  "title": "ARC-1 host toolchain lock",
  "type": "object",
  "required": ["schema", "python", "c_compiler", "python_packages", "optional_tools", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "arc1.toolchain-lock/0.2"},
    "python": {
      "type": "object",
      "required": ["min", "tested"],
      "additionalProperties": false,
      "properties": {
        "min": {"type": "string", "pattern": "^3\\.[0-9]+$"},
        "tested": {"type": "array", "items": {"type": "string"}}
      }
    },
    "c_compiler": {
      "type": "object",
      "required": ["standard", "candidates", "flags", "tested"],
      "additionalProperties": false,
      "properties": {
        "standard": {"const": "c11"},
        "candidates": {"type": "array", "minItems": 1, "items": {"enum": ["cc", "gcc", "clang"]}},
        "flags": {"type": "array", "items": {"type": "string", "pattern": "^-[A-Za-z0-9=_+-]+$"}},
        "tested": {"type": "array", "items": {"type": "string"}}
      }
    },
    "python_packages": {"type": "array", "maxItems": 0, "description": "The SDK core uses only the standard library."},
    "optional_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "phase"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}, "phase": {"type": "string"}}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
