{
  "description": "Variants of pass/complete. Each negative case introduces one defect and must fail with the named requirement code (TST-001). Positive cases are edge conditions that must still pass. Ops: set/remove a JSON pointer in pass.json, or write a file in the fixture copy.",
  "base": "complete",
  "negative": [
    {"id": "missing-sdk-evidence", "expect": "COV-002",
     "ops": [{"op": "set", "path": "/sdk_change/acceptance_tests", "value": ["frame-compare-negative-control"]}]},
    {"id": "sdk-path-missing", "expect": "COV-002",
     "ops": [{"op": "set", "path": "/sdk_change/paths", "value": ["sdk/tools/never_written.py"]}]},
    {"id": "sdk-not-separable", "expect": "COV-002",
     "ops": [{"op": "set", "path": "/sdk_change/paths", "value": ["src/layer.c"]}]},
    {"id": "sdk-not-reusable", "expect": "COV-002",
     "ops": [{"op": "set", "path": "/sdk_change/reusable", "value": false}]},
    {"id": "budget-below-five-percent", "expect": "COV-001",
     "ops": [{"op": "set", "path": "/effort/sdk_reserved", "value": 1.99}]},
    {"id": "changelog-only", "expect": "COV-004",
     "ops": [{"op": "write", "file": "CHANGELOG.md", "text": "- improved SDK\n"},
             {"op": "set", "path": "/sdk_change/paths", "value": ["CHANGELOG.md"]}]},
    {"id": "self-acceptance", "expect": "COV-003",
     "ops": [{"op": "set", "path": "/review/sdk_accepted_by", "value": "agent:fixture-author"}]},
    {"id": "complete-without-review", "expect": "COV-003",
     "ops": [{"op": "set", "path": "/review", "value": {"sdk_accepted_by": null, "state": "pending", "evidence": null}}]},
    {"id": "unapproved-deferral", "expect": "COV-006",
     "ops": [{"op": "set", "path": "/effort/sdk_reserved", "value": 0},
             {"op": "set", "path": "/deferral", "value": {"requirement": "COV-006", "reason": "Data-loss repair took the whole pass",
               "deferred_units": 2, "remediation": {"action": "Ship compare tool next pass", "owner": "agent:fixture-author", "due": "2026-11-30"},
               "approved_by": null}}]},
    {"id": "board-pass-without-board", "expect": "CLI-002",
     "ops": [{"op": "set", "path": "/validation/1", "value": {"id": "board", "level": "BOARD_TEST", "command": "arc1 device deploy",
               "result": "pass", "report": null, "board_id": null, "equipment": null, "reason": null}}]},
    {"id": "evidence-level-inflated", "expect": "CLI-002",
     "ops": [{"op": "set", "path": "/validation/0/level", "value": "RTL_SIM"}]},
    {"id": "verdict-contradicts-report", "expect": "PASS-004",
     "ops": [{"op": "set", "path": "/validation/0/result", "value": "fail"}]},
    {"id": "report-tampered", "expect": "PASS-004",
     "ops": [{"op": "write", "file": "reports/host-test.json", "text": "{\"verdict\": \"PASS\"}\n"}]},
    {"id": "artifact-tampered", "expect": "PASS-004",
     "ops": [{"op": "write", "file": "src/layer.c", "text": "int layer_count(void) { return 3; }\n"}]},
    {"id": "not-run-without-reason", "expect": "PASS-004",
     "ops": [{"op": "set", "path": "/validation/1/reason", "value": null}]},
    {"id": "handoff-not-reproducible", "expect": "PASS-005",
     "ops": [{"op": "write", "file": "HANDOFF.md", "text": "# Handoff\n\nSee the chat transcript.\n"}]},
    {"id": "blocked-without-blockers", "expect": "PASS-005",
     "ops": [{"op": "set", "path": "/state", "value": "BLOCKED"}]},
    {"id": "path-escape", "expect": "CLI-003",
     "ops": [{"op": "set", "path": "/sdk_change/paths", "value": ["../../../../etc/hostname"]}]},
    {"id": "branch-name-as-base", "expect": "SCHEMA",
     "ops": [{"op": "set", "path": "/base_commit", "value": "main"}]},
    {"id": "missing-owner", "expect": "SCHEMA",
     "ops": [{"op": "remove", "path": "/owner"}]},
    {"id": "two-owners", "expect": "SCHEMA",
     "ops": [{"op": "set", "path": "/owner", "value": "agent:a agent:b"}]}
  ],
  "positive": [
    {"id": "exactly-five-percent", "ops": [{"op": "set", "path": "/effort/planned_total", "value": 40},
                                           {"op": "set", "path": "/effort/sdk_reserved", "value": 2}]},
    {"id": "approved-deferral",
     "ops": [{"op": "set", "path": "/effort/sdk_reserved", "value": 0},
             {"op": "set", "path": "/deferral", "value": {"requirement": "COV-006", "reason": "Data-loss repair took the whole pass",
               "deferred_units": 2, "remediation": {"action": "Ship compare tool next pass", "owner": "agent:fixture-author", "due": "2026-11-30"},
               "approved_by": "human:fixture-owner"}}]},
    {"id": "review-state-pending", "ops": [{"op": "set", "path": "/state", "value": "REVIEW"},
                                           {"op": "set", "path": "/review", "value": {"sdk_accepted_by": null, "state": "pending", "evidence": null}}]}
  ]
}
