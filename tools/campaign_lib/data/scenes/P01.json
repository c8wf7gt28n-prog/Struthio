{
 "schema": "graphite.scene/1",
 "id": "P01",
 "title": "After Hours 07, the playable scene",
 "intent": "The owner's playable scene: open a menu across the head; Then over a CSV in Files (keep rows where unit is mA, count, put it in the writing line); back to the Field; trace 07 Bench readings; compare the two revisions of the limits. Every step is a desk act, played by pointer and by keys, and with less motion.",
 "seed": "after_hours_07",
 "given": {"size": [1920, 1200], "appearance": "graphite", "dial": "show"},
 "runs": [
  {"name": "mouse", "style": "pointer"},
  {"name": "keys", "style": "keys"},
  {"name": "mouse_still", "style": "pointer", "reduce_motion": true},
  {"name": "keys_still", "style": "keys", "reduce_motion": true}
 ],
 "steps": [
  {"act": "head.open", "args": {"menu": "Tools"},
   "expect": {"act.result.title": "Tools", "act.result.rows": {"contains": "System Check"}, "act.result.rows#apps": {"not": {"contains": "Programs"}}},
   "expect_by_run": {"keys": {"act.result.keyboard_route": false}, "keys_still": {"act.result.keyboard_route": false}}},
  {"act": "menu.close", "args": {},
   "expect": {"desk.where.popups": []}},
  {"act": "hand.write", "args": {"path": "07 Bench readings.csv", "text": "parameter,value,unit\nRail voltage,12,V\nSettled current,280,mA\nStartup current,650,mA\nStartup duration,110,ms\n"},
   "expect": {"act.result.ran": true, "act.result.hers": true, "act.result.undo": "/files.trash {\"path\": \"07 Bench readings.csv\"}",
              "desk.talk.trail.line": {"startswith": "/files.write"}}},
  {"act": "go.files", "args": {"view": "list"},
   "expect": {"desk.where.surface": "workspace", "desk.files.names": {"contains": "07 Bench readings.csv"}}},
  {"act": "menu.open", "args": {"on": "file", "name": "07 Bench readings.csv"},
   "expect": {"desk.menu.first": ["open", "ask", "rename", "trash", "then", "more"], "desk.menu.then_line": "@files:07 Bench readings.csv | rows"},
   "expect_by_run": {"mouse_still": {"desk.motion.calm": true}, "keys_still": {"desk.motion.calm": true}}},
  {"act": "menu.choose", "args": {"path": "then"},
   "expect": {"desk.menu.panel.count": "4 rows · 6 steps left"}},
  {"act": "then.keep", "args": {"column": "unit", "words": "is mA"},
   "expect": {"desk.menu.panel.count": "2 rows · 5 steps left"}},
  {"act": "then.count", "args": {},
   "expect": {"desk.menu.panel.line": "@files:07 Bench readings.csv | rows | where unit=mA | count", "desk.menu.panel.preview": [{"count": 2}]}},
  {"act": "then.end", "args": {"how": "line"},
   "expect": {"desk.line.text": "@files:07 Bench readings.csv | rows | where unit=mA | count", "desk.line.target": "her", "desk.menu.open": false,
              "act.result.outcome.ok": true}},
  {"act": "go.field", "args": {},
   "expect": {"desk.where.surface": "field", "desk.field.face": "work"}},
  {"act": "point.zoom", "args": {"to": "whole"},
   "expect": {"desk.field.whole": true}},
  {"act": "point.sheet", "args": {"title": "07 Bench readings"},
   "expect": {"desk.field.selected.title": "07 Bench readings"}},
  {"act": "sheet.trace", "args": {},
   "expect": {"desk.field.route.owner_title": "07 Bench readings"},
   "expect_by_seed": {"after_hours_07": {"desk.field.route.hops": 2, "desk.field.route.ends": {"contains": "07 Settled power"}, "desk.field.route.ends#startup": {"contains": "07 Startup power"}},
                      "bench": {"desk.field.route.hops": 0}},
   "expect_by_run": {"mouse_still": {"desk.field.route.animating": false}, "keys_still": {"desk.field.route.animating": false}}},
  {"act": "point.sheet", "args": {"title": "07 Limits Rev B CURRENT"},
   "expect": {"desk.field.selected.title": "07 Limits Rev B CURRENT"}},
  {"act": "sheet.compare", "args": {},
   "expect": {"desk.field.revisions.a": "07 Limits Rev A ARCHIVED", "desk.field.revisions.b": "07 Limits Rev B CURRENT",
              "desk.field.revisions.changed": {"contains": "Pulse duration"}, "desk.field.revisions.changed#ceiling": {"contains": "Pulse ceiling"}}},
  {"act": "sheet.close", "args": {},
   "expect": {"desk.field.revisions": null, "desk.where.surface": "field"}},
  {"act": "hand.undo", "args": {},
   "expect": {"act.result.state": "undone", "act.result.trashed": "07 Bench readings.csv"}}
 ]
}
