{
 "schema": "graphite.scene/1",
 "id": "P01",
 "title": "Rail Demo, the playable scene",
 "intent": "The owner's playable scene, written on Rail Demo, the workspace of invented data kept in the program: open a menu across the head; Then over a CSV in Files (keep rows where unit is mA, count, put it in the writing line); back to the Field; trace Rail Demo bench readings; compare the two revisions of the limits. Every step is a desk act, played by pointer and by keys, and with less motion.",
 "seed": "rail_demo",
 "given": {"size": [1920, 1200], "dial": "show"},
 "workspaces": {
  "after_hours_07": {
   "title": "After Hours 07, the playable scene",
   "intent": "The same scene on the owner's After Hours 07 backup, which is never shipped: the same acts in the same order, each of Rail Demo's names swapped for the one found there when the case runs, by its kind and the words it says. No name, number or record of the owner's workspace is written here.",
   "find": {
    "Rail Demo bench readings": {"kind": "sheet", "says": "bench readings"},
    "Rail Demo limits Rev A ARCHIVED": {"kind": "sheet", "says": "rev a archived"},
    "Rail Demo limits Rev B CURRENT": {"kind": "sheet", "says": "rev b current"},
    "Rail Demo settled power": {"kind": "calculation", "says": "settled power"},
    "Rail Demo startup power": {"kind": "calculation", "says": "startup power"},
    "Startup duration limit": {"kind": "row", "of": "Rail Demo limits Rev B CURRENT", "says": "duration"},
    "Startup power ceiling": {"kind": "row", "of": "Rail Demo limits Rev B CURRENT", "says": "ceiling"}
   }
  }
 },
 "runs": [
  {"name": "mouse", "style": "pointer"},
  {"name": "keys", "style": "keys"},
  {"name": "mouse_still", "style": "pointer", "reduce_motion": true},
  {"name": "keys_still", "style": "keys", "reduce_motion": true}
 ],
 "steps": [
  {"act": "head.open", "args": {"menu": "Tools"},
   "expect": {"act.result.title": "Tools", "act.result.rows": {"contains": "System Check"}, "act.result.rows#apps": {"not": {"contains": "Programs"}}},
   "expect_by_run": {"keys": {"act.result.keyboard_route": false}, "keys_still": {"act.result.keyboard_route": false}}},
  {"act": "menu.close", "args": {},
   "expect": {"desk.where.popups": []}},
  {"act": "hand.write", "args": {"path": "Rail Demo bench readings.csv", "text": "parameter,value,unit\nRail voltage,12,V\nSettled current,250,mA\nStartup current,900,mA\nStartup duration,45,ms\n"},
   "expect": {"act.result.ran": true, "act.result.hers": true, "act.result.undo": "/files.trash {\"path\": \"Rail Demo bench readings.csv\"}",
              "desk.talk.trail.line": {"startswith": "/files.write"}}},
  {"act": "go.files", "args": {"view": "list"},
   "expect": {"desk.where.surface": "workspace", "desk.files.names": {"contains": "Rail Demo bench readings.csv"}}},
  {"act": "menu.open", "args": {"on": "file", "name": "Rail Demo bench readings.csv"},
   "expect": {"desk.menu.first": ["open", "ask", "rename", "trash", "then", "more"], "desk.menu.then_line": "@files:Rail Demo bench readings.csv | rows"},
   "expect_by_run": {"mouse_still": {"desk.motion.calm": true}, "keys_still": {"desk.motion.calm": true}}},
  {"act": "menu.choose", "args": {"path": "then"},
   "expect": {"desk.menu.panel.count": "4 rows · 6 steps left"}},
  {"act": "then.keep", "args": {"column": "unit", "words": "is mA"},
   "expect": {"desk.menu.panel.count": "2 rows · 5 steps left"}},
  {"act": "then.count", "args": {},
   "expect": {"desk.menu.panel.line": "@files:Rail Demo bench readings.csv | rows | where unit=mA | count", "desk.menu.panel.preview": [{"count": 2}]}},
  {"act": "then.end", "args": {"how": "line"},
   "expect": {"desk.line.text": "@files:Rail Demo bench readings.csv | rows | where unit=mA | count", "desk.line.target": "her", "desk.menu.open": false,
              "act.result.outcome.ok": true}},
  {"act": "go.field", "args": {},
   "expect": {"desk.where.surface": "field", "desk.field.face": "work"}},
  {"act": "point.zoom", "args": {"to": "whole"},
   "expect": {"desk.field.whole": true}},
  {"act": "point.sheet", "args": {"title": "Rail Demo bench readings"},
   "expect": {"desk.field.selected.title": "Rail Demo bench readings"}},
  {"act": "sheet.trace", "args": {},
   "expect": {"desk.field.route.owner_title": "Rail Demo bench readings"},
   "expect_by_seed": {"rail_demo": {"desk.field.route.hops": 2, "desk.field.route.ends": {"contains": "Rail Demo settled power"}, "desk.field.route.ends#startup": {"contains": "Rail Demo startup power"}},
                      "after_hours_07": {"desk.field.route.hops": 2, "desk.field.route.ends": {"contains": "Rail Demo settled power"}, "desk.field.route.ends#startup": {"contains": "Rail Demo startup power"}},
                      "bench": {"desk.field.route.hops": 0}},
   "expect_by_run": {"mouse_still": {"desk.field.route.animating": false}, "keys_still": {"desk.field.route.animating": false}}},
  {"act": "point.sheet", "args": {"title": "Rail Demo limits Rev B CURRENT"},
   "expect": {"desk.field.selected.title": "Rail Demo limits Rev B CURRENT"}},
  {"act": "sheet.compare", "args": {},
   "expect": {"desk.field.revisions.a": "Rail Demo limits Rev A ARCHIVED", "desk.field.revisions.b": "Rail Demo limits Rev B CURRENT",
              "desk.field.revisions.changed": {"contains": "Startup duration limit"}, "desk.field.revisions.changed#ceiling": {"contains": "Startup power ceiling"}}},
  {"act": "sheet.close", "args": {},
   "expect": {"desk.field.revisions": null, "desk.where.surface": "field"}},
  {"act": "hand.undo", "args": {},
   "expect": {"act.result.state": "undone", "act.result.trashed": "Rail Demo bench readings.csv"}}
 ]
}
