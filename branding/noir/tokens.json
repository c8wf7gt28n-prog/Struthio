  "spacing_dip": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radii_dip": {
    "control": 4,
    "panel": 7
  },
  "icon_dip": {
    "dense": 16,
    "navigation": 20,
    "toolbar": 24
  },
  "minimum_control_target_dip": 32,
  "layout": {
    "engineering_start_proportions": [
      0.18,
      0.61,
      0.21
    ],
    "fixed_proportions": false,
    "navigator_minimum_dip": 220,
    "inspector_minimum_dip": 260,
    "workspaces_pinned_max": 5
  },
  "motion": {
    "reduced_motion_default": true,
    "ambient_motion_default": false,
    "sound_default": false
  },
  "notes": [
    "Token defaults are implementation proposals within the approved visual direction.",
    "Widget size hints and layouts must grow with fonts; do not fix text row heights.",
    "No electrical connectivity or authority is encoded in decorative assets."
