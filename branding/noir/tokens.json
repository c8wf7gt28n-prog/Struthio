{
  "schema": "arc.ledger.visual-tokens/1",
  "version": "1.0.0",
  "direction": "Approved noir Federation workshop",
  "colors": {
    "canvas": "#0E1116",
    "surface": "#171B21",
    "raised": "#222832",
    "line": "#667382",
    "text": "#F3F4F6",
    "muted": "#B5BEC8",
    "accent": "#FF9A32",
    "focus": "#FFB05C",
    "selection": "#332417",
    "disabled": "#707A87",
    "danger": "#FF9191",
    "success": "#8CDEB3",
    "paper": "#FAF7F0",
    "paper_text": "#182330",
    "paper_muted": "#485462",
    "paper_selection": "#FFDFC0",
