# STRUTHIO HANDHELD defaults (Waveshare ESP32-S3-Touch-LCD-3.5B)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# Service mode runs the golden replay on the main task: st_step needs about
# 6.2 KB of stack (joust_stage alone 5.1 KB), the same as the 12 KB game task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# A hung game or render task resets the toy back into the game.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Logs over the board's USB-C (native USB Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# AXP2101 PMIC (XPowersLib defaults to AXP192 on ESP32-S3; board_pmu.cpp also defines it)
CONFIG_XPOWERS_CHIP_AXP2101=y
# Hard power (the slide switch cuts BAT+): read back every flash write.
# NVS itself tolerates power loss; settings are written only when they change.
CONFIG_SPI_FLASH_VERIFY_WRITE=y
CONFIG_SPI_FLASH_LOG_FAILED_WRITE=y
# Boot time (docs/STRUTHIO_ONE_SLIM.md): no PSRAM pattern test, no full image hash at power-on (every flash
# write is read back, and esptool verifies the image when it is flashed), a quiet bootloader.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Boot time (docs/STRUTHIO_ONE_SLIM.md): no PSRAM pattern test, no full image hash at power-on (every flash
# write is read back, and esptool verifies the image when it is flashed), a quiet bootloader.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
