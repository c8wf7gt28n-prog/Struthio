#!/bin/sh
# 1.1 PK1: the computer's window (Kas) from the packaged program (what START_OFFICE.sh does in a folder install).
# Options pass through: kas-computer --version, kas-computer --check, kas-computer --doctor.
# 1.1 R1: the graphite-* names stay one release as symlinks to this file (tools/debian_pkg.py); called by one, say the new name.
case "${0##*/}" in graphite*) echo "${0##*/} is now kas-computer; the old name goes in the next release." >&2 ;; esac
export ARC_LEDGER_EDITION=office ARC_LEDGER_OPEN="${ARC_LEDGER_OPEN:-office}"
export PYTHONPATH="/usr/lib/graphite${PYTHONPATH:+:$PYTHONPATH}"
cd /usr/lib/graphite || exit 1
exec /usr/bin/python3 -m workbench.launch "$@"
