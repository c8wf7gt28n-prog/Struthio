+        self.assertEqual(exact(column(run(mixed, 'where v at most "M"'))), exact(['M', '']))
+        self.assertEqual(exact(column(run(mixed, 'where v at least 12'))), exact([12, '12']))
+
+    def test_3_group_keeps_true_apart_from_one(self):
