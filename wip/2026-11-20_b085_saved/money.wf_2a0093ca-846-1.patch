+        if word == 'within' and len(rest) == 2:args['within'] = [typed.number(rest[0]), typed.number(rest[1])]
+        elif word == 'step' and len(rest) == 1:args['step'] = typed.number(rest[0], True)
+        elif word == 'given' and 2 <= len(rest) <= 4:
