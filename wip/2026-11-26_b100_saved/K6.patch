+def _utility_row(row):
+    out = dict(zip(U_KEYS, row))
+    for k in ('inputs', 'look'):out[k] = json.loads(out[k] or 'null')
+    out['shown'] = bool(out['shown'])
+    return out
+
+
+def _run_row(row):
+    out = dict(zip(R_KEYS, row))
+    out['payload'] = json.loads(out['payload'] or '{}')
+    return out
