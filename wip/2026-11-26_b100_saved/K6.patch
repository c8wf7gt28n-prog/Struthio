+import time
+import uuid
+from pathlib import Path
+
+SCHEMA = 'graphite.sandbox/1'
+LIMITS = {'cpu_seconds': 10, 'memory_bytes': 512 * 1024 * 1024, 'file_bytes': 32 * 1024 * 1024, 'open_files': 64, 'wall_seconds': 30}
+MOST_INPUTS = 8
