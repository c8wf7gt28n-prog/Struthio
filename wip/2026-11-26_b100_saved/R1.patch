diff --git a/PREPARE_DEBIAN.sh b/PREPARE_DEBIAN.sh
index 7e8d402..ab2bc2b 100644
--- a/PREPARE_DEBIAN.sh
+++ b/PREPARE_DEBIAN.sh
@@ -30,6 +30,32 @@ done < "$inventory"
 [[ ${#packages[@]} -gt 0 && $wheels -gt 0 && $manifest -eq 1 ]] || fail 'The USB dependency checksum list is incomplete.'
 sha256sum --check --strict --quiet -- "$inventory" || fail 'The USB dependency files did not match. Re-extract both dependency archives.'
 
+# 1.0 R1: give apt only the files that move this system forward. The set only grows (the 1.0 packages sit beside the
+# 0.8.x ones), so a package already installed here at the same or a newer version (a system kept up to date) is left as
+# it is, and a package the set holds twice is taken at its newer version.
+declare -A newest_file=() newest_version=() newest_query=()
+for deb in "${packages[@]}"; do
+    fields=$(dpkg-deb --show --showformat='${Package} ${Version} ${Architecture}' "$deb") || fail "Debian could not read ${deb##*/}."
+    read -r name version arch <<< "$fields"
+    if [[ -z ${newest_version[$name]:-} ]] || dpkg --compare-versions "$version" gt "${newest_version[$name]}"; then
+        newest_file[$name]=$deb
+        newest_version[$name]=$version
+        newest_query[$name]=$name
+        [[ $arch == all ]] || newest_query[$name]=$name:$arch
+    fi
+done
+install=()
+current=0
+for name in "${!newest_file[@]}"; do
+    installed=$(dpkg-query --show --showformat='${db:Status-Abbrev}${Version}' "${newest_query[$name]}" 2>/dev/null || true)
+    if [[ $installed =~ ^.i\ (.+)$ ]] && dpkg --compare-versions "${BASH_REMATCH[1]}" ge "${newest_version[$name]}"; then
+        current=$((current + 1))
+    else
+        install+=("${newest_file[$name]}")
+    fi
+done
+if [[ ${#install[@]} -gt 0 ]]; then mapfile -t install < <(printf '%s\n' "${install[@]}" | LC_ALL=C sort); fi
+
 empty_sources=$(mktemp -d)
 trap 'rm -rf -- "$empty_sources"' EXIT
 mkdir -p "$empty_sources/sources.list.d" "$empty_sources/lists"
@@ -41,11 +67,22 @@ apt_options=(
     --no-remove --no-install-recommends
 )
 printf 'Verified %s Debian packages and %s Python wheels for Debian 13 amd64.\n' "${#packages[@]}" "$wheels"
+# 1.0 R1: say what is left as it is, and stop early when nothing is new
+printf '%s are already installed at the same or a newer version and stay as they are; %s to give to apt.\n' "$current" "${#install[@]}"
+if [[ ${#install[@]} -eq 0 ]]; then
+    printf '%s\n' 'Nothing to install: every package of this set is already here. Continue from your ordinary user account.'
+    exit 0
+fi
 if [[ $# -eq 1 ]]; then
-    plan=$(LC_ALL=C apt-get "${apt_options[@]}" -s install "${packages[@]}")
+    # 1.0 R1: when the plan does not resolve, show apt's reasons (they are on its standard output)
+    plan=$(LC_ALL=C apt-get "${apt_options[@]}" -s install "${install[@]}") || {
+        printf '%s\n' "$plan" | sed -n '/unmet dependencies/,$p' >&2
+        fail 'The offline package plan does not resolve on this computer; apt says why above. Nothing was changed.'
+    }
     printf '%s\n' "$plan" | awk '/ upgraded, .* newly installed, / {print}'
     printf '%s\n' 'Offline package plan resolved. Run the same script without --plan to install.'
 else
-    apt-get "${apt_options[@]}" -y install "${packages[@]}"
-    printf '%s\n' 'Verified offline Debian packages installed. Continue from your ordinary user account.'
+    apt-get "${apt_options[@]}" -y install "${install[@]}"
+    # 1.0 R1: the session services of the 1.0 set (logind's session, sound) start at the next login
+    printf '%s\n' 'Verified offline Debian packages installed. Log out and log in again, then continue from your ordinary user account.'
 fi
diff --git a/docs/MINIMAL_DEBIAN_INSTALL_01.md b/docs/MINIMAL_DEBIAN_INSTALL_01.md
index 657636b..30a6bee 100644
--- a/docs/MINIMAL_DEBIAN_INSTALL_01.md
+++ b/docs/MINIMAL_DEBIAN_INSTALL_01.md
@@ -8,6 +8,8 @@ The product goal is a minimal Debian edition whose main visible workspace is Gra
 
 The target is Debian 13 on the owner's AMD ThinkPad. No GNOME or KDE session is required. Python 3.11–3.13, the declared Qt runtime, display/input drivers and the existing programme dependencies are required. The dedicated session adds Xorg, xinit/startx, Fluxbox and a session bus. The optional minimal-session package group also includes NetworkManager and Mesa prerequisites.
 
+Since 1.0 (R1, the 1.0 System set) the minimal-session group and the offline System set also carry what the Living Desktop uses: udisks2 (USB drives), upower (the battery), pipewire, pipewire-pulse and wireplumber (sound), wpasupplicant and wireless-regdb (Wi-Fi through NetworkManager), eject, xsecurelock (Lock), polkitd with lxpolkit (the system's permission prompts), libpam-systemd (the login session that logind, the permission prompts and the sound services need), xdg-utils, x11-utils (xprop, xdpyinfo), at-spi2-core and python3-pyatspi (reading other programs), librsvg2-common (GTK's icons), alsa-ucm-conf and alsa-topology-conf (laptop sound cards); with LibreOffice, also libreoffice-writer, python3-uno and libreoffice-gtk3. Log out and log in again after installing them: the session services start at login. PREPARE_DEBIAN.sh leaves a package that is already installed at the same or a newer version as it is, so the set also installs on a Debian 13 that was updated since.
+
 From a local Debian text login, run `bash START_MINIMAL_DEBIAN.sh` in the installed programme. It checks the session commands (`startx`, `fluxbox`, `dbus-run-session` and an X server, `Xorg` or `X`) and calls startx with the supplied LS_XSESSION.sh. That session starts Fluxbox without its toolbar/slit and opens the Office fullscreen. Since 1.0 (S1, the session that survives) LS_XSESSION.sh is the session's small supervisor: Fluxbox and the session bus run for the whole session, and Graphite's window is its child, started again when it ends unexpectedly (a status other than 0) after a wait that grows (2 s, 4 s, 8 s, at most 30 s), at most three times in a row (`ARC_LEDGER_SESSION_RESTART_LIMIT`; a run of two minutes starts the count afresh); after that the session ends at the text console with a plain message. Apps opened from Graphite run in sessions of their own (`workbench/session_launch.py`), so they stay open while Graphite comes back. Exiting Graphite the ordinary way (Return to Debian, or the close after Log out, Restart or Shut down asked the system) ends this dedicated graphical session and returns to the text environment; starting Graphite on another workspace hands the start to the supervisor and the session goes on. From an existing display it opens the fullscreen Office without starting a second X server. Normal `bash START_OFFICE.sh` remains available.
 
 From a text login the script takes no arguments: `--doctor`, `--version` and similar options belong to `bash START_OFFICE.sh`, or to START_MINIMAL_DEBIAN.sh from an existing display, where they are forwarded. Starting a whole X session to answer `--version` would be untruthful, so the text-login branch refuses arguments with a message instead.
