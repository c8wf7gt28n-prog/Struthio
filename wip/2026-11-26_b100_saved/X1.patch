+    'refuted': '⊘ REFUTED · {text}',
+    'contested': '◆ CONTESTED · {text}',
+    'recheck': '◧ RECHECK · {text} (what it rests on changed since; it holds only once it is worked again)',
+    'unknown': '□ OPEN · {text}',
+    'question': '□ OPEN QUESTION · {text}',
