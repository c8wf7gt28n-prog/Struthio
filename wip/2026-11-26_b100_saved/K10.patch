+def tier(path):
+    from . import home_reach
+    try:first = Path(path).relative_to(home_reach.home()).parts
+    except ValueError:
+        return 2
+    if len(first) == 1 or first[0] in ('Documents', 'Desktop'):return 0
+    return 1 if first[0] == 'Downloads' else 2
