+class Unavailable(RuntimeError):
+    """The Everyday Home could not be built here; the message says why."""
+
+
+# ---- making the files -----------------------------------------------------------------------------------------------------
+def _qt():
+    """Qt's image classes. A picture is drawn with shapes only, so no window system is needed (no text is drawn)."""
+    try:
+        from PySide6.QtCore import QBuffer, QByteArray, QIODevice, QPointF, QRectF, Qt
+        from PySide6.QtGui import QBrush, QColor, QImage, QLinearGradient, QPainter, QPolygonF
+    except ImportError as exc:  # pragma: no cover - PySide6 is part of Graphite
+        raise Unavailable('Everyday Home draws its photos with Qt, and PySide6 is not here (%s).' % exc) from exc
+    return locals()
+
+
+def photo(scene, size=PHOTO_SIZE, fmt='JPG'):
+    """The bytes of one invented photo (JPEG, or PNG for a screenshot), drawn from its scene."""
+    q = _qt();QColor = q['QColor'];w, h = size
+    top, bottom, horizon, ground, shapes = (SCENES.get(scene) or USB_SCENES[scene])
+    image = q['QImage'](w, h, q['QImage'].Format_RGB32);image.fill(QColor(bottom))
+    painter = q['QPainter'](image);painter.setRenderHint(q['QPainter'].Antialiasing, True);painter.setPen(q['Qt'].NoPen)
+    sky = q['QLinearGradient'](0, 0, 0, h * (horizon or 100) / 100);sky.setColorAt(0, QColor(top));sky.setColorAt(1, QColor(bottom))
+    painter.fillRect(q['QRectF'](0, 0, w, h), q['QBrush'](sky))
+    if horizon:painter.fillRect(q['QRectF'](0, h * horizon / 100, w, h), QColor(ground))
+    for kind, colour, x, y, sw, sh in shapes:
+        painter.setBrush(QColor(colour));r = q['QRectF'](w * x / 100, h * y / 100, w * sw / 100, h * sh / 100)
+        if kind == 'ellipse':painter.drawEllipse(r)
+        elif kind == 'rect':painter.drawRect(r)
+        else:
+            P = q['QPointF']
+            points = ([P(r.left(), r.bottom()), P(r.center().x(), r.top()), P(r.right(), r.bottom())] if kind == 'tri'
+                      else [P(r.left(), r.top()), P(r.right(), r.top()), P(r.center().x(), r.bottom())])
+            painter.drawPolygon(q['QPolygonF'](points))
+    painter.end()
+    data = q['QByteArray']();buffer = q['QBuffer'](data);buffer.open(q['QIODevice'].WriteOnly)
+    if not image.save(buffer, fmt, 82 if fmt == 'JPG' else -1):
+        if fmt != 'PNG' and image.save(buffer, 'PNG'):
+            return bytes(data)
+        raise Unavailable('Qt could not write the photo "%s".' % scene)
+    return bytes(data)
+
+
+def pdf(pages):
+    """A PDF of (heading, lines) pages, written byte by byte as Home Demo's sources are (no clock, no id)."""
+    from .home_demo import LEFT, LINE, TOP, pages_pdf
+    out = []
+    for heading, lines in pages:
+        items = [(LEFT, TOP, 14, heading), (LEFT, TOP - 18, 9, NOTICE)];y = TOP - 54
+        for line in lines:
+            items.append((LEFT, y, 11, line));y -= LINE + 5
+        out.append(items + [(LEFT, 40, 9, NOTICE)])
+    return pages_pdf(out)
+
+
+def letter_odt():
+    """The letter to the landlord, a Writer document (the same bytes every time)."""
+    from xml.sax.saxutils import escape
+    from .office_bridge import ODT_TYPE, _NS, _package
+    body = ''.join('<text:p>%s</text:p>' % escape(line) for line in LETTER_LINES)
+    return _package(ODT_TYPE, '<office:document-content %s office:version="1.3"><office:body><office:text>%s</office:text>'
+                              '</office:body></office:document-content>' % (_NS, body))
+
+
+def _date_cell(day):
+    return '<table:table-cell office:value-type="date" office:date-value="%s"><text:p>%s</text:p></table:table-cell>' % (day, day)
+
+
+def _amount_cell(amount):
+    return '<table:table-cell office:value-type="float" office:value="%s"><text:p>%s</text:p></table:table-cell>' % (amount, amount)
+
+
+def budget_ods(rows=SPENDING, plan=PLAN):
+    """The household budget, a Calc spreadsheet: "Spending" (Date, Category, Item, Amount) and "Plan" (Category, A month)."""
+    from .office_bridge import ODS_TYPE, _NS, _package, _string_cell
+
+    def table(name, columns, body):
+        head = '<table:table-row>%s</table:table-row>' % ''.join(_string_cell(c) for c in columns)
+        return ('<table:table table:name="%s"><table:table-column table:number-columns-repeated="%d"/>%s%s</table:table>'
+                % (name, len(columns), head, ''.join('<table:table-row>%s</table:table-row>' % r for r in body)))
+    spending = [_date_cell(d) + _string_cell(c) + _string_cell(i) + _amount_cell(a) for d, c, i, a in rows]
+    spending.append(_string_cell(NOTICE))
+    planned = [_string_cell(c) + _amount_cell(a) for c, a in plan]
+    return _package(ODS_TYPE, '<office:document-content %s office:version="1.3"><office:body><office:spreadsheet>%s%s'
+                              '</office:spreadsheet></office:body></office:document-content>'
+                    % (_NS, table('Spending', ('Date', 'Category', 'Item', 'Amount'), spending), table('Plan', ('Category', 'A month'), planned)))
+
+
+def sound(notes, rate=8000, each=2400):
+    """A short sound (8-bit mono WAV) of whole-number square waves: no floating point, the same bytes every time."""
+    frames = bytearray()
+    for hz in notes:
+        half = max(1, rate // (2 * hz))
+        frames.extend((176 if (n // half) % 2 == 0 else 80) for n in range(each))
+    head = b'RIFF' + struct.pack('<I', 36 + len(frames)) + b'WAVEfmt ' + struct.pack('<IHHIIHH', 16, 1, 1, rate, rate, 1, 8)
+    return head + b'data' + struct.pack('<I', len(frames)) + bytes(frames)
+
+
+def _zip(names):
+    """The holiday photos, zipped as a download is (a fixed date on every member, so the same bytes every time)."""
+    out = io.BytesIO()
+    with zipfile.ZipFile(out, 'w', zipfile.ZIP_STORED) as z:
+        for name in names:
+            info = zipfile.ZipInfo('holiday/%s.jpg' % name, date_time=(2026, 8, 14, 12, 0, 0));z.writestr(info, photo(name))
+    return out.getvalue()
+
+
+def home_files():
+    """{path in the home folder: bytes} for everything the Everyday Home holds (the stick apart)."""
+    out = {LETTER: letter_odt(), LEASE: pdf(LEASE_PAGES), MANUAL: pdf(MANUAL_PAGES), BUDGET: budget_ods()}
+    for path, scene in PHOTOS.items():out[path] = photo(scene)
+    for path, (heading, lines) in DOWNLOAD_PDFS.items():out[path] = pdf(((heading, lines),))
+    for path, scene in DOWNLOAD_PHOTOS.items():out[path] = photo(scene, fmt='PNG' if path.endswith('.png') else 'JPG')
+    for path, words in TEXTS.items():out[path] = (words + NOTICE + '\n').encode('utf-8')
+    for path, original in DUPLICATES.items():out[path] = out[original]
+    out[ZIP] = _zip(ZIPPED)
+    out[TEMPLATE] = budget_ods(rows=(), plan=tuple((c, '0.00') for c, _ in PLAN))
+    for path, notes in SOUNDS.items():out[path] = sound(notes)
+    return out
+
+
+def usb_files():
+    """{path on the stick: bytes}: four holiday photos under DCIM/100DEMO."""
+    return {path: photo(scene) for path, scene in USB_PHOTOS.items()}
+
+
+def _write(folder, files):
+    made = {}
+    for rel, data in sorted(files.items()):
+        target = Path(folder) / rel;target.parent.mkdir(parents=True, exist_ok=True)
+        if target.exists():
+            raise Unavailable('Everyday Home is built only in an empty folder: %s is already there.' % target)
+        temporary = target.with_name('.' + target.name + '.writing');temporary.write_bytes(data);os.replace(temporary, target)
+        made[rel] = hashlib.sha256(data).hexdigest()
+    return made
+
+
+# ---- the door ------------------------------------------------------------------------------------------------------------
+def places(base):
+    """Where the Everyday Home lives under `base`: the home folder, the stick's contents, the workspace, the profile."""
+    base = Path(base)
+    home = base / 'home'
+    return {'base': base, 'home': home, 'usb': base / 'usb', 'concern': home / 'Concern', 'workspace': home / 'Concern' / 'Ledger',
+            'profile': base / 'profile'}
+
+
+def environment(base, appearance='', environ=None):
+    """The environment a window walking the Everyday Home starts with: HOME is its home folder, Graphite's workspace and
+    Concern folder where a fresh install keeps them in that home, a profile of its own, and the look asked for."""
+    where = places(base);env = dict(os.environ if environ is None else environ)
+    env.update(HOME=str(where['home']), ARC1_WORKBENCH_CONFIG_HOME=str(where['profile']), ARC_LEDGER_WORKSPACE=str(where['workspace']),
+               ARC_LEDGER_CONCERN=str(where['concern']))
+    env.pop('ARC_LEDGER_EDITION', None)
+    if appearance:env['GRAPHITE_APPEARANCE'] = appearance
+    return env
+
+
+def build(base):
+    """Build the Everyday Home in `base` (a new or empty throwaway folder): the home folder with its five folders and their
+    files, the stick's contents, and an empty Graphite workspace in the home's Concern folder. Never the home folder of the
+    person at the computer. Returns {'home', 'usb', 'workspace', 'profile', 'files': {path: sha256}, 'usb_files': {...}}."""
+    where = places(base);base = where['base']
+    real_home = Path(os.path.expanduser('~')).resolve()
+    if where['home'].resolve() == real_home or real_home.is_relative_to(base.resolve()):
+        raise Unavailable('Everyday Home is never built in your own home folder: give it a new throwaway folder.')
+    base.mkdir(parents=True, exist_ok=True)
+    for name in FOLDERS:(where['home'] / name).mkdir(parents=True, exist_ok=True)
+    files = _write(where['home'], home_files());stick = _write(where['usb'], usb_files())
+    from .locations import ensure_workspace
+    ensure_workspace(where['workspace']);where['profile'].mkdir(parents=True, exist_ok=True)
+    return {'home': str(where['home']), 'usb': str(where['usb']), 'workspace': str(where['workspace']), 'profile': str(where['profile']),
+            'files': files, 'usb_files': stick}
+
+
+def digests():
+    """The SHA-256 of every file the Everyday Home holds, as made now (the same every time)."""
+    return {**{rel: hashlib.sha256(data).hexdigest() for rel, data in home_files().items()},
+            **{'usb/' + rel: hashlib.sha256(data).hexdigest() for rel, data in usb_files().items()}}
+
+
+def spent(category, month, rows=SPENDING):
+    """What the budget's rows say was spent on `category` in `month` ('2026-11'): (total as text, the rows), exactly."""
+    picked = [r for r in rows if r[1].casefold() == category.casefold() and r[0].startswith(month)]
+    cents = sum((Fraction(r[3]) for r in picked), Fraction(0)) * 100
+    if cents.denominator != 1:
+        raise ValueError('An amount in the budget is not in whole cents.')
+    return '%d.%02d' % divmod(int(cents), 100), picked
+
+
+def main(argv=None):
+    argv = list(sys.argv[1:] if argv is None else argv)
+    if len(argv) != 1:
+        print(json.dumps({'ok': False, 'why': 'usage: python -m workbench.everyday_demo FOLDER'}));return 2
+    try:
+        made = build(Path(argv[0]))
+    except (Unavailable, OSError, ValueError) as exc:
+        print(json.dumps({'ok': False, 'why': str(exc)[:300]}));return 1
+    print(json.dumps({'ok': True, **{k: v for k, v in made.items() if k not in ('files', 'usb_files')},
+                      'files': len(made['files']), 'usb_files': len(made['usb_files'])}))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
