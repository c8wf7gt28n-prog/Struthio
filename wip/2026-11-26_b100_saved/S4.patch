+
+def row(*parts, stretch_at=None):
+    line = QHBoxLayout();line.setSpacing(12)
+    for i, part in enumerate(parts):
+        if part is None:continue
+        if isinstance(part, QWidget):line.addWidget(part, 1 if i == stretch_at else 0)
