+    p.drawEllipse(QRectF(px * 0.08, px * 0.2, px * 0.84, px * 0.6))
+    p.setBrush(QColor(colour));p.drawRect(QRectF(px * 0.36, px * 0.38, px * 0.28, px * 0.24))
+    p.end()
+    return pixmap
