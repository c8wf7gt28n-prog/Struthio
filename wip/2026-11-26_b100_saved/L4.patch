+            except (ValueError, OSError):pass
+            tab.set_dirty(False)
+        elif hasattr(tab, 'can_close_pdf') and hasattr(tab, 'clear_editor'):
+            tab.clear_editor()
+    except Exception as exc:  # noqa: BLE001
