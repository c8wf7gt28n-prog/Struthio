+        except Exception as exc:  # noqa: BLE001 - a dock that cannot stand leaves the strip where S3 put it
+            state['why'] = 'The app strip stays in Graphite\'s window: %s.' % (str(exc)[:160] or type(exc).__name__)
+            host.system_dock = None
+
+    def gone(*_):
