diff --git a/workbench/her_poses.py b/workbench/her_poses.py
new file mode 100644
index 0000000..425edea
--- /dev/null
+++ b/workbench/her_poses.py
@@ -0,0 +1,360 @@
+"""Her poses and faces from your workspace (Graphite 1.0, P5): kasandra/hologram/, admitted once, like her portrait.
+
+The owner's pictures of her (26 November 2026: a blue hologram in a dark tee with the circuit-ostrich on it, jeans and
+sneakers; a sheet of full-figure poses, close faces, a small walking sprite cycle and a kit) stay out of the program, as her
+portrait does (PLAN_1.0 section 3). Her hologram becomes a set when you put the pictures in <workspace>/kasandra/hologram/
+and admit them:
+
+    quiet.png  working.png  thinking.png  waiting.png  done.png  halt.png  asleep.png      a pose for each state of hers
+    faces/smile.png  faces/wink.png  faces/closed.png  faces/knowing.png                   a face for the small slots
+    walk/01.png ... walk/NN.png                                                            the walking sprite, in order
+    badge.png  wordmark.png                                                                the kit (kept with the set)
+
+(a pose may also be .jpg or .jpeg). Admitting keeps each picture's exact bytes as a kept copy under
+kasandra/.revisions/poses/<sha256>.png (or .jpg) and one line in kasandra/.revisions/poses.json naming the set: every
+picture by its name and SHA-256, and the set's digest. Her column draws the kept copies, never the folder, so a picture you
+change afterwards changes nothing until you admit the set again. Taking an earlier set back is a new line pointing at the
+same bytes; "her single figure again" is a line with no set (her_portrait's picture, or the shipped art, as P3 drew it).
+
+    kasandra.poses        {}                                read     the set in force and the folder now, in plain words
+    kasandra.poses.admit  {expected_sha256} or {revision}   approve  admit the folder as it is now (the digest you read),
+                          or {shipped: true}                         take an earlier set back, or her single figure again
+
+The set's digest is the SHA-256 of its lines "<name> <sha256>\\n", in name order: admitting checks that the folder is still
+the one you read. Only a picture is kept (PNG or JPEG by its first bytes, each at most MOST_BYTES, the set at most
+MOST_SET); whether it decodes is the window's to find (a pose that will not decode is not drawn: its fallback is). A link
+is never followed, neither the folder nor a picture in it. A name the set does not know is listed as not used, never kept.
+
+Which pose her state shows (pose_for), and which face a small slot shows (face_for):
+
+    HALT holds her work, or a stop   halt      turned away              face: closed
+    something waits for you          waiting   pointing                 face: smile
+    her model answering, her plan    thinking  chin on her hand         face: knowing
+    working                          working   walking                  face: knowing
+    done                             done      arms crossed             face: wink
+    quiet, her model ready           quiet     standing                 face: smile
+    quiet, no model ready            asleep    eyes closed              face: closed
+
+A pose missing from the set falls back to your portrait (her_portrait), else to the set's quiet pose, else to the shipped
+art; a face missing, to another face of the set; with no set in force, nothing changes (P3's single figure).
+
+Nothing here is a model's word: admitting is your press (the approve scope), and the read is an observer (showing her
+column is not an event). The pictures and their kept copies are private, as her portrait is: PRIVATE_NAME finds them by
+name in a payload or an archive (tools/check_hatch.py carries the same rule).
+
+Pure Python: no Qt, no model, no network, no float.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+
+FOLDER = 'kasandra'
+SET = 'hologram'
+REVISIONS = '.revisions'
+KEPT = 'poses'
+INDEX = 'poses.json'
+SCHEMA = 'kasandra.poses/1'
+INDEX_SCHEMA = 'ledger.poses/1'
+MOST_BYTES = 8 * 1024 * 1024
+MOST_SET = 64 * 1024 * 1024
+MOST_FILES = 64
+WALK_MOST = 24
+KINDS = {'png': b'\x89PNG\r\n\x1a\n', 'jpg': b'\xff\xd8\xff'}
+SUFFIXES = ('.png', '.jpg', '.jpeg')
+POSES = ('quiet', 'working', 'thinking', 'waiting', 'done', 'halt', 'asleep')
+FACES = ('smile', 'wink', 'closed', 'knowing')
+KIT = ('badge', 'wordmark')
+FACE_FOR = {'quiet': 'smile', 'working': 'knowing', 'thinking': 'knowing', 'waiting': 'smile', 'done': 'wink', 'halt': 'closed',
+            'asleep': 'closed'}
+FACE_ORDER = ('smile', 'knowing', 'wink', 'closed')
+WALK_NAME = re.compile(r'^walk/(\d{2})\.(?:png|jpe?g)$')
+PRIVATE_NAME = re.compile(r'(?:^|[/!\\])(?:kasandra[/\\]hologram[/\\](?:[^/\\]+[/\\])?[^/\\]+\.(?:png|jpe?g)'
+                          r'|\.revisions[/\\]poses[/\\][0-9a-f]{64}\.(?:png|jpg))$', re.IGNORECASE)
+
+WORDS = {
+    'none': 'There is no pose set of yours in this workspace; her hologram is her single figure.',
+    'waiting': 'Your pose set kasandra/hologram ({count} pictures) is in the workspace and not admitted; her hologram is her single figure.',
+    'in_force': 'Her poses are your set, admitted as revision {revision} ({count} pictures).',
+    'single': 'Her hologram is her single figure (your portrait, or the shipped art).',
+    'changed': 'Your pose set changed after it was admitted; the admitted one is shown until you admit it again.',
+    'missing': 'Poses not in the set, shown by her single figure: {names}.',
+    'not_used': 'Not used (names the set does not know): {names}.',
+    'kept': 'Kept your pose set as revision {revision}; her hologram takes a pose for each state now.',
+    'same': 'That pose set is already the one in force; nothing changed.',
+    'back': 'Her hologram is her single figure again (revision {revision}); your pictures stay where they are.',
+}
+_SHA = {}       # path -> (mtime_ns, size, sha256): a file is read again only when it changed
+
+
+def _say(key, **slots):
+    return WORDS[key].format(**slots)
+
+
+def sha256(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def kind_of(raw):
+    """'png' or 'jpg' by the picture's first bytes, else ''."""
+    for kind, magic in KINDS.items():
+        if raw[:len(magic)] == magic:return kind
+    return ''
+
+
+def _kasandra(root):
+    folder = Path(root) / FOLDER
+    if folder.is_symlink():raise ValueError('POSES_LINK: the kasandra folder is a link; it is not followed')
+    return folder
+
+
+def _set_folder(root):
+    folder = _kasandra(root) / SET
+    if folder.is_symlink():raise ValueError('POSES_LINK: the kasandra/hologram folder is a link; it is not followed')
+    return folder
+
+
+def known(name):
+    """Whether a name inside kasandra/hologram/ is one the set knows (a pose, a face, a walking frame, the kit)."""
+    stem, dot, suffix = name.rpartition('.')
+    if not dot or '.' + suffix.lower() not in SUFFIXES:return False
+    if '/' not in stem:return stem in POSES or stem in KIT
+    group, _, base = stem.partition('/')
+    if group == 'faces':return base in FACES
+    if group == 'walk':
+        match = WALK_NAME.match(name.lower())
+        return bool(match) and 1 <= int(match.group(1)) <= WALK_MOST
+    return False
+
+
+def _file_sha(path):
+    stat = path.stat()
+    seen = _SHA.get(str(path))
+    if seen and seen[0] == stat.st_mtime_ns and seen[1] == stat.st_size:return seen[2]
+    if stat.st_size > MOST_BYTES:raise ValueError('POSES_TOO_LARGE: a picture of the set is at most %d bytes' % MOST_BYTES)
+    sha = sha256(path.read_bytes())
+    _SHA[str(path)] = (stat.st_mtime_ns, stat.st_size, sha)
+    return sha
+
+
+def digest_of(rows):
+    """The set's digest: the SHA-256 of its lines "<name> <sha256>\\n", in name order."""
+    return sha256(''.join('%s %s\n' % (name, rows[name]['sha256']) for name in sorted(rows)).encode('utf-8'))
+
+
+def scan(root):
+    """The folder now: ({name: {sha256, bytes, kind, path}}, [names not used], [problems in words]). Nothing is followed
+    through a link; a picture that is not a PNG or JPEG, or too large, is a problem, never kept."""
+    try:folder = _set_folder(root)
+    except ValueError as exc:return {}, [], [str(exc)]
+    if not folder.is_dir():return {}, [], []
+    rows, extra, problems, total = {}, [], [], 0
+    candidates = []
+    for entry in sorted(folder.iterdir()):
+        if entry.is_symlink():problems.append('POSES_LINK: %s is a link; it is not followed' % entry.name);continue
+        if entry.is_dir():
+            if entry.name not in ('faces', 'walk'):extra.append(entry.name + '/');continue
+            for inner in sorted(entry.iterdir()):
+                name = '%s/%s' % (entry.name, inner.name)
+                if inner.is_symlink():problems.append('POSES_LINK: %s is a link; it is not followed' % name);continue
+                if inner.is_file():candidates.append((name, inner))
+                else:extra.append(name + '/')
+        elif entry.is_file():candidates.append((entry.name, entry))
+    for name, path in candidates:
+        if not known(name):extra.append(name);continue
+        if len(rows) >= MOST_FILES:problems.append('POSES_TOO_MANY: a set is at most %d pictures; %s is left out' % (MOST_FILES, name));continue
+        try:
+            size = path.stat().st_size
+            if size > MOST_BYTES:raise ValueError('POSES_TOO_LARGE: %s is over %d bytes' % (name, MOST_BYTES))
+            if total + size > MOST_SET:raise ValueError('POSES_SET_TOO_LARGE: the set is at most %d bytes; %s is left out' % (MOST_SET, name))
+            with open(path, 'rb') as stream:head = stream.read(16)
+            kind = kind_of(head)
+            if not kind:raise ValueError('POSES_NOT_A_PICTURE: %s is not a PNG or JPEG picture' % name)
+            rows[name] = {'sha256': _file_sha(path), 'bytes': size, 'kind': kind, 'path': str(path)}
+            total += size
+        except (OSError, ValueError) as exc:
+            problems.append(str(exc))
+    stems = {}
+    for name in sorted(rows):      # one picture a name: quiet.png before quiet.jpg; a second is not used
+        stem = name.rsplit('.', 1)[0]
+        if stem in stems:extra.append(name);rows.pop(name)
+        else:stems[stem] = name
+    return rows, extra, problems
+
+
+def _index_path(root):
+    return _kasandra(root) / REVISIONS / INDEX
+
+
+def index(root):
+    """{'schema', 'revisions': [{'revision', 'set': {name: {sha256, kind}} ({} for her single figure), 'digest', 'origin',
+    'at', 'from'?}]}."""
+    try:value = json.loads(_index_path(root).read_text(encoding='utf-8'))
+    except (OSError, ValueError):return {'schema': INDEX_SCHEMA, 'revisions': []}
+    if not isinstance(value, dict) or value.get('schema') != INDEX_SCHEMA or not isinstance(value.get('revisions'), list):
+        return {'schema': INDEX_SCHEMA, 'revisions': []}
+    return value
+
+
+def kept_path(root, sha, kind):
+    return _kasandra(root) / REVISIONS / KEPT / ('%s.%s' % (sha, 'png' if kind == 'png' else 'jpg'))
+
+
+def _write_atomic(path, raw):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name('.%s.partial' % path.name)
+    with open(temporary, 'wb') as stream:
+        stream.write(raw);stream.flush();os.fsync(stream.fileno())
+    os.replace(temporary, path)
+
+
+def _now():
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
+
+
+def in_force(root):
+    """({name: path of its kept copy}, the revision row or None): what her hologram draws. A kept copy whose bytes are not
+    the recorded ones is left out (its fallback is drawn)."""
+    try:rows = index(root)['revisions']
+    except ValueError:return {}, None
+    if not rows:return {}, None
+    row = rows[-1];out = {}
+    for name, kept in sorted((row.get('set') or {}).items()):
+        if not known(name) or not isinstance(kept, dict) or not re.fullmatch(r'[0-9a-f]{64}', str(kept.get('sha256', ''))):continue
+        try:
+            path = kept_path(root, kept['sha256'], kept.get('kind'))
+            if path.is_symlink() or not path.is_file() or _file_sha(path) != kept['sha256']:continue
+        except (OSError, ValueError):
+            continue
+        out[name] = path
+    return out, row
+
+
+def by_role(names):
+    """{'poses': {pose: name}, 'faces': {face: name}, 'walk': [names in order], 'kit': {name: name}} of a set's names."""
+    out = {'poses': {}, 'faces': {}, 'walk': [], 'kit': {}}
+    for name in sorted(names):
+        stem = name.rsplit('.', 1)[0]
+        if stem in POSES:out['poses'][stem] = name
+        elif stem in KIT:out['kit'][stem] = name
+        elif stem.startswith('faces/'):out['faces'][stem[6:]] = name
+        elif stem.startswith('walk/'):out['walk'].append(name)
+    out['walk'].sort(key=lambda n: int(WALK_NAME.match(n.lower()).group(1)))
+    return out
+
+
+def state(root):
+    """The set in force and the folder now, in plain words (what kasandra.poses answers)."""
+    paths, row = in_force(root)
+    rows, extra, problems = scan(root)
+    folder = None
+    if rows or extra or problems:
+        folder = {'name': '%s/%s' % (FOLDER, SET), 'digest': digest_of(rows) if rows else '', 'count': len(rows),
+                  'bytes': sum(r['bytes'] for r in rows.values()), 'names': sorted(rows), 'not_used': sorted(extra), 'problems': problems}
+    words = [];roles = by_role(paths)
+    if paths:words.append(_say('in_force', revision=row['revision'], count=len(paths)))
+    elif row is not None and not row.get('set'):words.append(_say('single'))
+    waiting = bool(rows) and (row is None or row.get('digest') != folder['digest'])
+    if waiting:words.append(_say('changed') if paths else _say('waiting', count=len(rows)))
+    if not paths and not rows:words.append(_say('none'))
+    missing = [pose for pose in POSES if pose not in roles['poses']] if paths else []
+    if missing:words.append(_say('missing', names=', '.join(missing)))
+    if folder and folder['not_used']:words.append(_say('not_used', names=', '.join(folder['not_used'][:8])))
+    words += problems[:4]
+    force = None
+    if paths:
+        force = {'revision': row['revision'], 'digest': row.get('digest', ''), 'count': len(paths),
+                 'paths': {name: str(path) for name, path in paths.items()},
+                 'poses': sorted(roles['poses']), 'faces': sorted(roles['faces']), 'walk': len(roles['walk']), 'kit': sorted(roles['kit'])}
+    return {'schema': SCHEMA, 'in_force': force, 'revision': row['revision'] if row else 0, 'folder': folder,
+            'waiting': waiting, 'missing': missing, 'words': words}
+
+
+def _append(root, row):
+    value = index(root);rows = value['revisions']
+    row = dict(row, revision=len(rows) + 1, at=_now());rows.append(row)
+    _write_atomic(_index_path(root), json.dumps(value, indent=1, sort_keys=True).encode('utf-8'))
+    return row
+
+
+def admit(root, expected_sha256=None, revision=None, shipped=False):
+    """Admit your folder as it is now (only when its digest is the one you read), take an earlier set back, or her single
+    figure again. Each is a new line in the index; your pictures themselves are never written."""
+    if sum(1 for given in (expected_sha256 is not None, revision is not None, bool(shipped)) if given) != 1:
+        raise ValueError('POSES_ADMIT: give expected_sha256, revision or shipped')
+    rows = index(root)['revisions']
+    if shipped:
+        if rows and not rows[-1].get('set'):return {'changed': False, 'words': [_say('same')], 'state': state(root)}
+        row = _append(root, {'set': {}, 'digest': '', 'origin': 'SINGLE_FIGURE'})
+        return {'changed': True, 'revision': row, 'words': [_say('back', revision=row['revision'])], 'state': state(root)}
+    if revision is not None:
+        if not 1 <= revision <= len(rows):raise ValueError('POSES_NO_SUCH_REVISION: there is no revision %d' % revision)
+        old = rows[revision - 1]
+        for name, kept in (old.get('set') or {}).items():
+            path = kept_path(root, kept['sha256'], kept.get('kind'))
+            if not path.is_file() or sha256(path.read_bytes()) != kept['sha256']:
+                raise ValueError('POSES_KEPT_COPY_DAMAGED: the kept copy of %s in revision %d is not the picture admitted' % (name, revision))
+        if rows[-1].get('digest', '') == old.get('digest', ''):return {'changed': False, 'words': [_say('same')], 'state': state(root)}
+        row = _append(root, {'set': old.get('set') or {}, 'digest': old.get('digest', ''), 'origin': 'TAKEN_BACK', 'from': revision})
+        return {'changed': True, 'revision': row, 'words': [_say('kept', revision=row['revision'])], 'state': state(root)}
+    found, _, problems = scan(root)
+    if not found:raise ValueError('POSES_NO_SET: there is no picture the set knows in kasandra/hologram' + (' (%s)' % problems[0] if problems else ''))
+    if digest_of(found) != expected_sha256:
+        raise ValueError('POSES_SET_CHANGED: the pose set changed after you read it; read it again before admitting')
+    if rows and rows[-1].get('digest') == expected_sha256:return {'changed': False, 'words': [_say('same')], 'state': state(root)}
+    kept_set = {}
+    for name, info in sorted(found.items()):
+        raw = Path(info['path']).read_bytes()
+        if sha256(raw) != info['sha256']:
+            raise ValueError('POSES_SET_CHANGED: %s changed while it was being kept; read the set again before admitting' % name)
+        kept = kept_path(root, info['sha256'], info['kind'])
+        if not kept.is_file() or sha256(kept.read_bytes()) != info['sha256']:_write_atomic(kept, raw)
+        kept_set[name] = {'sha256': info['sha256'], 'kind': info['kind']}
+    row = _append(root, {'set': kept_set, 'digest': expected_sha256, 'origin': 'YOUR_FOLDER'})
+    return {'changed': True, 'revision': row, 'words': [_say('kept', revision=row['revision'])], 'state': state(root)}
+
+
+def private_in(names):
+    """The names (shipped paths, or archive!member) that are your pose set or its kept copies."""
+    return [name for name in names if PRIVATE_NAME.search(str(name))]
+
+
+# -- which pose, which face ---------------------------------------------------------------------------------------------------
+def pose_for(state_key, held=False, ready=False, thinking=False):
