+class SlotFace(QWidget):
+    """Her face in a small slot ('name': by her name in her column, following her pose; 'toast': smiling, or the knowing look
+    for an urgent one). Hidden while no pose set is in force."""
+
+    def __init__(self, host, slot, tall=24, chooser=None):
+        super().__init__();self.host = host;self.slot = slot;self.tall = tall;self.chooser = chooser;self.shown_face = ''
+        self.setObjectName('HerFace' + slot.capitalize());self.setAttribute(Qt.WA_TransparentForMouseEvents)
+        self.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
+        _enlist(host, self);self.follow()
+
+    def face(self):
+        if self.chooser is not None:
+            want = self.chooser();faces = poses(self.host).faces()
+            return want if want in faces else hp.face_for('quiet', faces)
+        return face_of(self.host)
+
+    def follow(self):
+        face = self.face() if poses(self.host).active() else ''
+        if face != self.shown_face:
+            self.shown_face = face
+            words = FACE_WORDS.get(face, '')
+            pose = POSE_WORDS.get(getattr(self.host, '_her_pose', None) or 'quiet', '')
+            self.setAccessibleName(say('face', name=named('Stacy'), pose=pose if self.slot == 'name' else words) if face else '')
+            self.setToolTip(say('face', name=named('Stacy'), pose=pose) if face and self.slot == 'name' else '')
+            self.updateGeometry()
+        self.setVisible(bool(face))
+        self.update()
+
+    def sizeHint(self):
+        return QSize(max(8, round(self.tall * 0.8)), self.tall)
+
+    def minimumSizeHint(self):
+        return self.sizeHint()
+
+    def paintEvent(self, event):
+        if not self.shown_face:return
+        image, key = poses(self.host).face(self.shown_face)
+        if image is None:return
+        h = min(self.height(), self.tall);w = min(self.width(), round(h * 0.8) + 2)
+        art = small(image, key, w, h, self.devicePixelRatioF())
+        if art is None:return
+        p = QPainter(self);p.drawImage(QRectF((self.width() - w) / 2.0, (self.height() - h) / 2.0, w, h), art);p.end()
+
+
+def name_face(column):
