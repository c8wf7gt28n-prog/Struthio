+# ------------------------------------------------------------------------------------------------------------ the dock
+def hand_live(host):
+    """(acting, program, act): her hand in another program now (K9's live state, read through the Kernel, an observer)."""
+    live = ((_read(host, 'program.status', {'live': True}) or {}).get('live')) or {}
+    if live.get('state') != 'acting':return False, '', ''
+    age = (time.time_ns() // 1000000 - int(live.get('at') or 0)) // 1000
+    if age > ACTING_KEEP_S:return False, '', ''
+    from .her_column_qt import plain
+    return True, plain(live.get('program') or 'a program'), plain(live.get('act') or live.get('words') or '')
