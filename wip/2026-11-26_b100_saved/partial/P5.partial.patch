+class DockKas(QAbstractButton):
+    """Beside Graphite's entry in the dock: her face for her pose; while her hand works in another program, her walking
+    sprite and "Kasandra in <program>". A press brings Graphite's window forward, as the entry does. Hidden (no width)
+    while no pose set is in force."""
+
+    def __init__(self, dock):
+        super().__init__(dock);self.dock = dock;self.host = dock.host
+        self.mode = 'face';self.program = '';self.act = '';self.frame = 0;self.ticks = 0
+        self.setObjectName('GraphiteDockKas');self.setCursor(Qt.PointingHandCursor);self.setFocusPolicy(Qt.NoFocus);self.setAttribute(Qt.WA_Hover)
+        self.clicked.connect(dock.bring_graphite)
+        self.timer = QTimer(self);self.timer.setTimerType(Qt.CoarseTimer);self.timer.setInterval(1000);self.timer.timeout.connect(self.tick)
+        self.timer.start()
+        _enlist(self.host, self);self.follow()
+
+    def active(self):
+        return poses(self.host).active()
+
+    def follow(self):
+        self.words();self.update()
+
+    def words(self):
+        name = named('Stacy')
+        if self.mode == 'walk':
+            tip = say('dock_hand_tip', name=name, program=self.program, act=self.act or POSE_WORDS['working'])
+        else:
+            tip = say('dock_face', name=name, pose=POSE_WORDS.get(getattr(self.host, '_her_pose', None) or 'quiet', ''))
+        self.setToolTip(tip);self.setAccessibleName(tip)
+
+    def label(self):
+        return say('dock_hand', name=named('Stacy'), program=self.program) if self.mode == 'walk' else ''
+
+    def natural(self, h):
+        """Its width in a dock h tall: 0 with no set; her face; or her sprite and the words while she walks."""
+        if not self.active():return 0
+        if self.mode != 'walk':return round((h - 6) * 0.8) + 12
+        fm = QFontMetrics(self.font())
+        return round((h - 4) * 0.62) + 10 + min(fm.horizontalAdvance(self.label()), 260) + 12
+
+    def tick(self):
+        if getattr(self.host, '_closing', False):self.timer.stop();return
+        self.ticks += 1
+        if self.mode == 'walk' and not still(self.host):
+            self.frame += 1;self.update()
+            if self.ticks % LIVE_EVERY:return
+        self.read_live()
+
+    def read_live(self):
+        if not self.active():
+            if self.isVisible():self.dock.arrange()
+            return
+        try:acting, program, act = hand_live(self.host)
+        except Exception:  # noqa: BLE001 - her hand's state cannot be read: her face
+            acting, program, act = False, '', ''
+        walk = acting and bool(poses(self.host).roles['walk'])
+        mode = 'walk' if walk else 'face'
+        if (mode, program) != (self.mode, self.program) or act != self.act:
+            changed = (mode, program) != (self.mode, self.program)
+            self.mode, self.program, self.act = mode, program, act;self.frame = 0
+            self.timer.setInterval(WALK_MS if mode == 'walk' and not still(self.host) else 1000)
+            self.words()
+            if changed:self.dock.arrange()
+            self.update()
+
+    def paintEvent(self, event):
+        if not self.active():return
+        p = QPainter(self);w, h = self.width(), self.height()
+        if self.isDown():p.fillRect(self.rect(), QColor(bt.LINE))
+        elif self.underMouse():p.fillRect(self.rect(), QColor(bt.RAISED))
+        ps = poses(self.host);dpr = self.devicePixelRatioF()
+        if self.mode == 'walk':
+            frames = ps.walk()
+            if frames:
+                image, key = frames[0 if still(self.host) else self.frame % len(frames)]
+                fh = h - 4;fw = round(fh * 0.62)
+                art = small(image, key, fw, fh, dpr)
+                if art is not None:p.drawImage(QRectF(6, 2, fw, fh), art)
+                x = 6 + fw + 6
+                fm = QFontMetrics(self.font());p.setPen(QColor(bt.TEXT))
+                p.drawText(QRect(x, 0, w - x - 6, h - 2), Qt.AlignLeft | Qt.AlignVCenter, fm.elidedText(self.label(), Qt.ElideRight, max(10, w - x - 6)))
+        else:
+            face = face_of(self.host)
+            image, key = ps.face(face)
+            if image is not None:
+                fh = h - 6;fw = round(fh * 0.8)
+                art = small(image, key, fw, fh, dpr)
+                if art is not None:p.drawImage(QRectF((w - fw) / 2.0, 3, fw, fh), art)
+        p.fillRect(w - 1, round(h * 0.22), 1, round(h * 0.56), QColor(bt.LINE_MID))
+        p.end()
+
