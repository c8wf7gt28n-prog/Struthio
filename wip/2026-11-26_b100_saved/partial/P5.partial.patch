+def steady(stage, holo, share, fig, box, day):
+    """Her box when a pose set is in force: as wide as her widest pose and as tall as her tallest (from their headers,
+    nothing decoded), so a change of pose never moves the bars or Day's glass; her figure (fig) is the pose's own, in it.
+    None when she is not a pose."""
+    if not is_pose(getattr(holo, 'key', None)):return None
+    ps = poses(stage.column.host)
+    w, h = stage.width(), stage.height();room_w, room_h = w - (24 if day else 8), h - (6 if day else 2)
+    widest = 0.60 if day else 0.86;off_x, off_y = (24 if day else 8) // 2, 6 if day else 2
+    union = QRect(fig)
+    for name in ps.roles['poses'].values():
+        size = ps.size(name)
+        if size.isEmpty():continue
+        part = share if size.height() >= size.width() * 13 // 10 else 1.0
+        aspect = size.width() / max(1.0, size.height() * part)
+        fh = max(8, room_h - 2);fw = fh * aspect
+        if fw > room_w * widest:fw = room_w * widest;fh = fw / aspect
+        fw, fh = max(4, round(fw)), max(4, round(fh))
+        union = union.united(QRect((room_w - fw) // 2 + off_x, room_h - fh + off_y, fw, fh))
+    if day:
+        pad = max(8, round(union.width() * 0.07));top = max(0, union.y() - pad)
+        box = QRect(union.x() - pad, top, union.width() + 2 * pad, h - top)
+    else:
+        m = max(4, round(union.width() * 0.08));box = union.adjusted(-m, -m, m, m).intersected(stage.rect())
+    return fig, box
+
+
+# ------------------------------------------------------------------------------------------------------------ the cross-fade
+def before_take(holo, key):
+    """Her hologram takes a new picture: when both are poses, the one before is kept to fade out (not with Reduce motion,
+    not before it was ever drawn). True when a cross-fade starts (then no arrival static: the change's own static stands)."""
+    if not (is_pose(key) and is_pose(holo.key)) or holo.k is None or holo.light is None or getattr(holo, 'last_fig', None) is None:
+        holo.prev = None;return False
+    if holo.still():
+        holo.prev = None;return True
+    holo.prev = (holo.light, QRectF(holo.last_fig));holo.fade_from = time.monotonic()
+    if holo.timer is not None:holo.timer.setInterval(FADE_FRAME_MS)
+    return True
+
+
+def paint_before(holo, p, still_):
+    """The pose before, fading out where it stood; the share (0 to 1) the new pose is drawn at."""
+    prev = getattr(holo, 'prev', None)
+    if prev is None:return 1.0
+    t = (time.monotonic() - getattr(holo, 'fade_from', 0.0)) / (CROSSFADE_MS / 1000.0)
+    if still_ or t >= 1.0:
+        holo.prev = None
+        if holo.timer is not None:
+            from .her_hologram_qt import FRAME_MS
+            holo.timer.setInterval(FRAME_MS)
+        return 1.0
+    t = max(0.0, t);light, fig = prev
+    dpr = holo.widget.devicePixelRatioF();m = light.margin / dpr
+    p.save();p.setRenderHint(QPainter.SmoothPixmapTransform)
+    p.setOpacity(0.55 * (1.0 - t));p.drawImage(QRectF(fig.x() - m, fig.y() - m, fig.width() + 2 * m, fig.height() + 2 * m), light.glow)
+    p.setOpacity(0.95 * (1.0 - t));p.drawImage(fig, light.scans[0])
+    p.restore()
+    return t
+
+
+def moment_figure(mine, moment):
+    """A moment's own pose from your set (HALT turned away, done arms crossed, refuted pointing): True when it is drawn so."""
+    pose = MOMENT_POSE.get(getattr(moment, 'kind', ''))
+    if not pose:return False
+    ps = poses(moment.host)
+    if not ps.active():return False
+    image, key = ps.pose(pose)
+    if image is None:return False
+    mine.take(image, key)
+    return mine.k is not None and not mine.k.image.isNull()
+
