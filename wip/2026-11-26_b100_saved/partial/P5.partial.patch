+def tell_faces(host):
+    """Her pose changed (or the set did): every small slot of hers draws again."""
+    for widget in list(getattr(host, '_her_faces', ()) or ()):
+        try:widget.follow()
+        except RuntimeError:      # the slot is gone (a toast closed)
+            try:host._her_faces.remove(widget)
+            except (AttributeError, ValueError):pass
+
+
+def _enlist(host, widget):
+    try:
+        faces = host.__dict__.setdefault('_her_faces', [])
+        faces.append(widget)
+    except Exception:  # noqa: BLE001
+        pass
