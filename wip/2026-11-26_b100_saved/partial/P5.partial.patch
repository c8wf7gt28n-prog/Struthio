+    HALT holds her work, whether her model is ready, and whether she is thinking (her model answering, her hand planning)."""
+    if held or state_key in ('held', 'blocked'):return 'halt'
+    if state_key == 'awaiting_approval':return 'waiting'
+    if state_key == 'working':return 'thinking' if thinking else 'working'
+    if state_key == 'completed':return 'done'
+    if thinking:return 'thinking'
+    return 'quiet' if ready else 'asleep'
+
+
+def face_for(pose, faces):
+    """The face (a name in `faces`) for a pose: its own, else the first of FACE_ORDER the set has, else ''."""
+    own = FACE_FOR.get(pose, 'smile')
