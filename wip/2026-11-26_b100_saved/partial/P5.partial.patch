+def share_for(holo, share):
+    """A pose that is a face or a seated figure no taller than it is wide is shown whole; a standing one as P3 shows her."""
+    k = getattr(holo, 'k', None)
+    if k is None or not is_pose(getattr(holo, 'key', None)) or k.ink.isEmpty():return share
+    return share if k.ink.height() >= k.ink.width() * 13 // 10 else 1.0
