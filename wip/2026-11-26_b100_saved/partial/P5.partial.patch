+def source(portrait):
+    """(image, focal x, focal y, zoom, key) for her pose from your set, or None: P1's order (your portrait, the shipped
+    art) then stands. A pose missing from the set: your portrait when one is admitted, else the set's quiet pose."""
+    ps = poses(portrait.host)
+    if not ps.active():return None
+    pose = getattr(portrait, 'pose', None)
+    if pose is None:
+        pose = portrait.pose = pose_now(portrait)
+    image, key = ps.pose(pose)
+    if image is None:
+        if ((portrait.column.portrait_state or {}).get('in_force') or {}).get('path'):return None
+        image, key = ps.pose('quiet')
