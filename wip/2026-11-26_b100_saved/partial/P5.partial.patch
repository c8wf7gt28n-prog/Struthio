+# ------------------------------------------------------------------------------------------------------------ small slots
+def small(image, key, W, H, dpr=1.0):
+    """A face or a sprite frame, W x H (logical), in her hologram's treatment at a small size: its ground keyed, a soft
+    glow, the scan lines. Composed once a size and kept."""
+    from .her_hologram_qt import Light, fit, keyed
+    ck = (key, W, H, dpr)
+    if ck in _SMALL:return _SMALL[ck]
+    k = keyed(image, key)
+    if k.image.isNull() or W < 4 or H < 4:return None
+    w, h = max(4, round(W * dpr)), max(4, round(H * dpr));m = max(1, round(min(w, h) * 0.06))
+    box = fit(k, 1.0, w - 2 * m, h - 2 * m, 1.0)
+    if box.isEmpty():return None
+    box.translate(m, m)
+    light = Light(k, 1.0, box.width(), box.height(), fade=0)
+    out = QImage(w, h, QImage.Format_ARGB32_Premultiplied);out.fill(Qt.transparent)
+    p = QPainter(out);p.setRenderHint(QPainter.SmoothPixmapTransform)
+    g = light.margin
+    p.setOpacity(0.5);p.drawImage(QRect(box.x() - g, box.y() - g, box.width() + 2 * g, box.height() + 2 * g), light.glow)
+    p.setOpacity(1.0);p.drawImage(box, light.scans[0]);p.end()
+    out.setDevicePixelRatio(dpr)
+    _SMALL[ck] = out
+    while len(_SMALL) > SMALL_KEEP:_SMALL.pop(next(iter(_SMALL)))
+    return out
+
