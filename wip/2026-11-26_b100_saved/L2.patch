+def _call(fn, kernel, focus, ident):
+    """relevance.why / pin / turn_down, whichever of the two plain signatures it has."""
+    try:return fn(kernel, focus, ident)
+    except TypeError:
+        try:return fn(kernel, ident)
+        except Exception:  # noqa: BLE001
+            return None
+    except Exception:  # noqa: BLE001
+        return None
