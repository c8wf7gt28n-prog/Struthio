+        lists.append({'_w': view, 'current': QPersistentModelIndex(view.currentIndex()), 'selected': chosen, 'n': len(chosen), 'name': _name(view)})
+    snap['_lists'] = lists;snap['lists'] = [l['name'] for l in lists]
