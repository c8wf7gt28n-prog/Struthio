+            scrolls.append({'_w': area, 'h': area.horizontalScrollBar().value(), 'v': area.verticalScrollBar().value(), 'name': _name(area)})
+    snap['_scrolls'] = scrolls;snap['scrolls'] = [[s['name'], s['h'], s['v']] for s in scrolls]
