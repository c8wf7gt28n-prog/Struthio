+                    row = dict(instance=_decode(parts[0]) if parts else '', klass=_decode(parts[1]) if len(parts) > 1 else '',
+                               pid=int(pid[0]) if pid else None, machine=_decode(self.prop(w, 'WM_CLIENT_MACHINE')),
