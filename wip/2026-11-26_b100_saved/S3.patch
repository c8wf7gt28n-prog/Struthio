+        try:return XpropBackend(env.get('DISPLAY'))
+        except Unavailable as second:
+            if str(second).startswith(NO_LIST):raise
+            raise Unavailable(NO_LIST + ': neither libX11 nor xprop (x11-utils) is installed') from second
