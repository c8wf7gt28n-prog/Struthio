+MILLI = {'V': 'mV', 'A': 'mA', 'W': 'mW', 's': 'ms'}
+MONTH_NAMES = ('January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November',
+               'December')
