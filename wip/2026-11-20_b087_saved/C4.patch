+                 "can't", "won't", "isn't", "doesn't", "don't", "didn't", "wasn't", "aren't", "weren't", "hasn't",
+                 "haven't", "shouldn't", "wouldn't", "couldn't", "mustn't", "ain't", 'cant', 'wont', 'isnt', 'doesnt', 'dont'),
