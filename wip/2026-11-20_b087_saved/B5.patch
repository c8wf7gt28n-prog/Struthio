+# == 0.8.7 B5 · your words: agreed READ readings become name and saying rows of this phrasebook ================================
+NAME_SHAPE = SHAPE + 'name:'
+SAYING_SHAPE = SHAPE + 'saying:'
+WORD_KINDS = ('name', 'saying')
