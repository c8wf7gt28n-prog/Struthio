+def words(seal):
+    """The one line under the model's name, or None when no seal is recorded (a model started before 0.8.7)."""
+    if not isinstance(seal, dict):
+        return None
+    return SEALED_WORDS if seal.get('state') == 'SEALED' else NOT_SEALED_WORDS
