+    rows += ['0. %s' % brief_mod.NONE_WORDS, 'His words: %s' % brief_mod.fence(b.words), 'His request: %s' % brief_mod.fence(b.request)]
+    return '%s\n%s\n%s' % (brief_mod.FENCE_OPEN, '\n'.join(rows), brief_mod.FENCE_CLOSE)
