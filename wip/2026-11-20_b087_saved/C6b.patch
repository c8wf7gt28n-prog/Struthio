+    try:result = extract.bounded(earlier['name'], intake.vault(ns).path(earlier['sha256']), earlier['sha256'])
+    except OSError as exc:raise ValueError('CROSSREFS_EARLIER_UNREADABLE: %s' % str(exc)[:120]) from None
+    pages = [{'segment': s.get('id'), 'locator': s.get('locator'), 'text': s.get('text') or ''} for s in result.get('segments') or ()]
+    rows = lib.source_rows(key, pages)
+    if len(_EARLIER) > 64:_EARLIER.clear()
+    _EARLIER[key] = rows
+    return rows
+
+
+def _files(kernel, principal, namespace=None, item=None):
+    """[(namespace, item, name, rows)] of the files admitted now (the Library's index, brought up to date first)."""
+    from . import library_service as lib
+    spaces, _counts, _digest = lib.refresh(kernel, principal, namespace)
+    with kernel.db() as db:rows = lib.entries(lib.DbStore(db), spaces, spaces)
+    files, order = {}, []
+    for row in rows:
+        key = (row['namespace'], row['item'])
+        if item and row['item'] != item:continue
+        if key not in files:files[key] = [];order.append(key)
+        files[key].append(row)
+    return [(k[0], k[1], files[k][0].get('name', ''), files[k]) for k in order]
+
+
+def links(kernel, principal, namespace=None, item=None, label=None):
+    """library.links: {'files': [{'namespace', 'item', 'name', 'earlier' ({item, sha256} or None), 'earlier_state',
+    'links', 'gone', 'outside', 'counts', 'said'}], 'said', 'counts', 'model_calls': 0}. label: only the wires touching
+    that place. Nothing is written but the Library's rebuildable index."""
+    out, said_all = [], []
+    totals = {s: 0 for s in STATES}
+    for nsid, ident, name, rows in _files(kernel, principal, namespace, item):
+        with kernel.db() as db:
+            try:before = earlier_item(db, nsid, ident)
+            except ValueError:before = None
+            earlier_state, previous = ('NONE', None) if before is None else ('COMPARED', None)
+            if before is not None:
+                try:previous = earlier_rows(db, nsid, before, principal.identity)
+                except (ValueError, KeyError):earlier_state = 'UNREAD'
+        compared = of_file(rows, name, previous)
+        if label:
+            compared['links'] = [l for l in compared['links'] if label in (l['source'], l['target'])]
+            compared['gone'] = [g for g in compared['gone'] if label in (g['source'], g['target'])]
+            compared['outside'] = [o for o in compared['outside'] if o['source'] == label]
+            compared['counts'] = {s: sum(1 for l in compared['links'] if l['state'] == s) for s in STATES}
+            if not compared['links'] and not compared['gone'] and not compared['outside']:continue
+        lines = said(compared, name, earlier_state)
+        for s in STATES:totals[s] += compared['counts'][s]
+        out.append({'namespace': nsid, 'item': ident, 'name': name,
+                    'earlier': {'item': before['id'], 'sha256': before['sha256']} if before else None, 'earlier_state': earlier_state,
+                    'links': compared['links'], 'gone': compared['gone'], 'outside': compared['outside'], 'counts': compared['counts'],
+                    'said': lines})
+        said_all += lines
+    return {'title': WORDS['title'], 'files': out, 'said': said_all, 'counts': totals, 'version': VERSION, 'model_calls': 0}
+
+
+def into(kernel, principal, namespace, item, label, most=INTO_MOST):
+    """Her lines for the places of one file that refer to `label` (Ask the Library adds them under the place it lit): at
+    most `most`, in reading order, each '§ 12(b) refers to § 12(a): “...”'. Only wires whose target is found. No model."""
+    from . import library_service as lib
+    if not label:return []
+    with kernel.db() as db:rows = [r for r in lib.entries(lib.DbStore(db), {namespace: ''}) if r['item'] == item]
+    found = find(rows)
+    return [WORDS['refers'].format(source=l['source'], target=l['target'], quote=l['quote'])
+            for l in found['links'] if l['found'] and l['target'] == label][:most]
+
+
+# ============================================================================================================ the Kernel
+_ID = {'type': 'string', 'pattern': '^[a-f0-9]{32}$'}
+FIELDS = {
+    'library.links': ({'namespace': _ID, 'item': _ID, 'label': {'type': 'string', 'minLength': 1, 'maxLength': 80}}, ['namespace']),
+}
+SCOPES = {op: 'read' for op in FIELDS}
+
+
+def dispatch(kernel, op, args, principal):
+    if op == 'library.links':return links(kernel, principal, args['namespace'], args.get('item'), args.get('label'))
+    raise ValueError('Unknown cross-reference operation')
