+
+def _verify_moves(plan, change):
+    wrong = []
+    for m in change['moves']:
+        try:ok = os.lstat(m['to']).st_ino == m['ino'] and (not os.path.lexists(m['from']) or os.path.samefile(m['from'], m['to']))
+        except OSError:
