+    plan['checked'] = ('%s read back at the new place, the same file, the old place empty' % count_words(len(change['moves']), 'file') if not wrong
+                       else '%s not where they should be: %s' % (count_words(len(wrong), 'file'), ', '.join(wrong[:3])))
