+            try:old.hide();old.deleteLater()
+            except RuntimeError:pass
+        return made
+
+    def slot(self, name):
+        return self.slots.get(name)
+
+    def slot_width(self, name, h):
+        w = self.slots.get(name)
+        if w is None:return 0
