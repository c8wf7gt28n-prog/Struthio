+        checks = dict((k, w) for k, _, w in verdict.checks)
+        refused = '%s (%s)' % (checks.get('argv', ''), checks.get('why', ''))
+    desk = got.value
+    return (desk['argv'] if desk else None), refused, 'dictionary'
