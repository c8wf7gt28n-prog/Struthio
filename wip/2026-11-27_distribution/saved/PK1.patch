diff --git a/debian/kit/JOIN.sh b/debian/kit/JOIN.sh
new file mode 100644
index 0000000..ae61ea9
--- /dev/null
+++ b/debian/kit/JOIN.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# 1.1 PK1: put the kit's repository together: check the kit's files (KIT.sha256), unpack every GRAPHITE_NNN.zip into
+# ./repo, check every piece by sha256, join the pieces of each large file, check the joined file, then check every file
+# of the repository (SHA256SUMS). Needs only bash, coreutils and python3 (for the ZIPs; unzip is not needed).
+#   bash JOIN.sh          (in the kit's folder, as your ordinary user)
+set -euo pipefail
+cd "$(dirname -- "${BASH_SOURCE[0]}")"
+if [[ -f KIT.sha256 ]]; then
+  sha256sum --quiet -c KIT.sha256 || { echo 'A kit file does not match KIT.sha256: copy the kit again.' >&2; exit 1; }
+fi
+rm -rf repo
+for z in GRAPHITE_*.zip; do python3 -m zipfile -e "$z" . ; done
+while read -r sum name whole; do
+  [[ -n "$sum" ]] || continue
+  if [[ "$whole" == WHOLE ]]; then
+    cat "repo/$name".[0-9][0-9][0-9] > "repo/$name"
+    echo "$sum  repo/$name" | sha256sum --quiet -c - || { echo "The joined file $name does not match." >&2; exit 1; }
+    rm -f "repo/$name".[0-9][0-9][0-9]
+  else
+    echo "$sum  repo/$name" | sha256sum --quiet -c - || { echo "The piece $name does not match." >&2; exit 1; }
+  fi
+done < PIECES.sha256
+( cd repo && sha256sum --quiet -c ../SHA256SUMS ) || { echo 'A file of the repository does not match SHA256SUMS.' >&2; exit 1; }
+echo "JOINED AND CHECKED: $(ls repo/*.deb | wc -l) packages in $(pwd)/repo"
diff --git a/debian/kit/START_HERE.md b/debian/kit/START_HERE.md
new file mode 100644
index 0000000..e0be398
--- /dev/null
+++ b/debian/kit/START_HERE.md
@@ -0,0 +1,77 @@
+# Graphite @VERSION@: install it as Debian software
+
+This kit installs Graphite with `apt`, from a folder on your USB stick. It is made for a Debian 13 computer that
+already has the Graphite 1.0 System set (the packages the 1.0 kit installed). Nothing here needs the network.
+
+It goes in **two stages**. Stage 1 changes nothing about how the computer starts: you still log in on the text console
+and start Graphite with one command. Stage 2, the graphical login screen, is optional and separate, because a login
+screen changes how the computer boots. Do stage 2 only after stage 1 works.
+
+## Your Graphite 1.0 stays
+
+If you have `~/Applications/Graphite-1.0`, leave it. The new Graphite opens the same workspace (`~/Concern/Office`) and
+the same settings; nothing is moved or copied. To go back at any time, start the old one as before:
+`bash ~/Applications/Graphite-1.0/START_MINIMAL_DEBIAN.sh`. To take the new one away, see "Going back" below.
+
+## 0. Put the kit together (as your ordinary user)
+
+Copy every file of the kit into one folder on the stick or in your home, for example `~/GraphiteKit`. Then:
+
+    cd ~/GraphiteKit
+    bash JOIN.sh
+
+It checks every file by sha256, unpacks the ZIPs into `repo/` and joins the large files from their pieces. It ends
+with `JOINED AND CHECKED`. If it says a file does not match, copy that file again and run it again.
+
+## 1. Stage 1: Graphite and its session (the text console way, as before)
+
+Become root and look first (this changes nothing):
+
+    su -
+    bash /home/YOU/GraphiteKit/install.sh --check
+
+Then install:
+
+    bash /home/YOU/GraphiteKit/install.sh
+
+It copies the repository to `/var/lib/graphite-kit/repo`, adds it as an apt source and runs
+`apt-get install graphite graphite-session`. Type `exit` to leave root. Log out and in again on the text console (the
+session services need a fresh login), then start Graphite exactly as before, with one command:
+
+    graphite-startx
+
+Check it from a terminal at any time: `graphite --version`, `graphite-doctor doctor`.
+
+## 2. Stage 2, optional: the graphical login screen
+
+Only when stage 1 works. As root:
+
+    bash /home/YOU/GraphiteKit/install.sh --desktop
+
+This installs `graphite-desktop`: LightDM's login screen, set to start the Graphite session. At the next boot you log
+in on the login screen instead of the text console.
+
+**To undo it**, two commands, as root:
+
+    systemctl disable lightdm
+    apt remove graphite-desktop lightdm lightdm-gtk-greeter
+
+**If the login screen does not come up** after a reboot: press Ctrl+Alt+F2 for a text console, log in as root, type
+`systemctl disable --now lightdm`, then log in as your user and type `graphite-startx`. Graphite starts as in stage 1.
+
+## Going back
+
+- Remove the new Graphite (as root): `apt remove graphite graphite-session graphite-llama-runtime graphite-desktop`.
+  Your workspace in `~/Concern`, your settings in `~/.config/arc1-workbench` and `~/.local/state/ledger-slate` stay.
+  Your old `~/Applications/Graphite-1.0` keeps working.
+- Remove the kit's apt source and its copy (as root): `bash install.sh --forget`.
+
+## What this preview is and is not
+
+- The packages are not signed with a Graphite release key yet; the release key is the owner's to make and keep. The
+  kit's apt source is marked trusted and every file is checked by sha256 (`SHA256SUMS`, `PIECES.sha256`,
+  `KIT.sha256`), and apt checks every package against the repository's index.
+- Tried in the build container: the packages build; from these ZIPs alone (joined and checked), `apt install graphite
+  graphite-session` succeeds in a fresh Debian 13 chroot that has the 1.0 System set's packages; `graphite --check`
+  passes as an ordinary user with nothing written under `/usr`; `apt remove graphite` leaves the workspace.
+- Not tried there, and only your computer can show it: the login screen itself, the session under it, Wi-Fi and sound.
diff --git a/debian/kit/install.sh b/debian/kit/install.sh
new file mode 100644
index 0000000..21d8acd
--- /dev/null
+++ b/debian/kit/install.sh
@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# 1.1 PK1: install Graphite from the kit's folder repository with apt. Run as root (su -), after bash JOIN.sh:
+#   bash install.sh --check      show what apt would do; changes nothing
+#   bash install.sh              stage 1: graphite and graphite-session (start with graphite-startx, as before)
+#   bash install.sh --desktop    stage 2, optional: graphite-desktop, the graphical login (LightDM)
+#   bash install.sh --forget     remove the kit's apt source and its copy (installed packages stay)
+# The repository is copied to /var/lib/graphite-kit/repo and added as an apt source. A preview kit is not signed: the
+# source is marked trusted and every file is checked by sha256 (SHA256SUMS here, and apt checks each package against
+# Packages). A signed kit carries graphite-archive-keyring.gpg and is used with Signed-By instead.
+set -euo pipefail
+kit="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+mode="${1:-install}"
+place=/var/lib/graphite-kit/repo; list=/etc/apt/sources.list.d/graphite-kit.list; key=/usr/share/keyrings/graphite-archive-keyring.gpg
+[[ "$EUID" == 0 ]] || { echo 'Run install.sh as root: su -   then   bash '"$kit"'/install.sh' >&2; exit 1; }
+if [[ "$mode" == --forget ]]; then
+  rm -f -- "$list" "$key"; rm -rf -- /var/lib/graphite-kit
+  echo 'The kit source is gone. Installed packages stay; apt remove takes them away.'; exit 0
+fi
+case "$mode" in install|--check|--desktop) ;; *) echo "Unknown option: $mode (use --check, --desktop or --forget)" >&2; exit 2 ;; esac
+. /etc/os-release
+[[ "${ID:-}" == debian && "${VERSION_ID:-}" == 13 ]] || { echo "This kit is for Debian 13; this is ${PRETTY_NAME:-unknown}." >&2; exit 1; }
+[[ "$(dpkg --print-architecture)" == amd64 ]] || { echo 'This kit is for amd64 computers.' >&2; exit 1; }
+[[ -f "$kit/repo/Packages" ]] || { echo 'No repository yet: run   bash JOIN.sh   in the kit folder first (as your user).' >&2; exit 1; }
+echo 'Checking every file of the repository (sha256)...'
+( cd "$kit/repo" && sha256sum --quiet -c "$kit/SHA256SUMS" ) || { echo 'A file does not match SHA256SUMS. Copy the kit again.' >&2; exit 1; }
+if [[ "$kit/repo" != "$place" ]]; then
+  rm -rf -- "$place.new"; mkdir -p "$(dirname "$place")"; cp -r -- "$kit/repo" "$place.new"
+  rm -rf -- "$place"; mv -- "$place.new" "$place"
+fi
+chmod -R a+rX /var/lib/graphite-kit
+if [[ -f "$place/graphite-archive-keyring.gpg" && -f "$place/InRelease" ]]; then
+  install -m 644 "$place/graphite-archive-keyring.gpg" "$key"
+  echo "deb [signed-by=$key] file:$place ./" > "$list"
+else
+  echo "deb [trusted=yes] file:$place ./" > "$list"
+fi
+apt-get update -o Dir::Etc::sourcelist="$list" -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0
+packages='graphite graphite-session'
+[[ "$mode" == --desktop ]] && packages='graphite-desktop'
+if [[ "$mode" == --check ]]; then
+  apt-get install -s $packages | grep -E '^(Inst|Conf|Remv|[0-9]+ upgraded|E:)' || true
+  echo 'Nothing was changed (--check).'; exit 0
+fi
+apt-get install -y $packages
+if [[ "$mode" == --desktop ]]; then
+  echo 'Installed graphite-desktop. At the next boot the login screen offers the Graphite session.'
+  echo 'To go back to the text console:  systemctl disable lightdm   (then reboot; graphite-startx still works there)'
+  echo 'To remove the login screen:      apt remove graphite-desktop lightdm lightdm-gtk-greeter'
+else
+  echo 'Installed graphite and graphite-session. Log out of root, log in as your user on the text console and type:'
+  echo '  graphite-startx'
+fi
