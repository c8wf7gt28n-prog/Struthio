+            raise LookupError('The restored workspace holds %s %s.' % (len(rows) or 'no', what))
+        return rows[0]
+    objects = call('field.read')['objects']
+    sheet = one([o for o in objects if o['kind'] == 'sheet' and 'bench readings' in o['title'].casefold()],
