  "udisks2": "plan s.4; S4 (USB drives)",
  "upower": "plan s.4; S4 (battery)",
  "pipewire": "plan s.4; S4 (sound)",
  "pipewire-pulse": "plan s.4; S4 (sound)",
  "wireplumber": "plan s.4; S4 (wpctl)",
  "xsecurelock": "plan s.4; S1 (Lock)",
  "lxpolkit": "plan s.4; S5 (permission prompts)",
  "xdg-utils": "plan s.4 (default programs)",
  "x11-utils": "plan s.4; S3 (xprop fallback), hatch_readiness (xdpyinfo)",
  "libreoffice-writer": "plan s.4; K5/K6",
  "python3-uno": "plan s.4; K5 (office_bridge)",
  "at-spi2-core": "plan s.4; K7, K9",
  "libreoffice-gtk3": "plan s.4; K9",
  "python3-pyatspi": "plan s.4 (K7: not needed by its reader; kept as the plan lists it)",
  "libpam-systemd": "R1: a logind session at login (S1 Lock/Suspend, polkit \"active\" rules for udisks2 and NetworkManager, XDG_RUNTIME_DIR and the user manager that starts PipeWire); recommended by udisks2 and network-manager",
  "wpasupplicant": "R1: NetworkManager cannot do Wi-Fi without it (only recommended, so the 0.8.x set lacks it); S4 Wi-Fi",
  "wireless-regdb": "R1: the Wi-Fi regulatory database NetworkManager recommends",
  "eject": "R1: udisks2 Drive.Eject runs it (S4 eject when power-off is not offered)",
  "librsvg2-common": "R1: GTK3 needs the SVG icon loader (lxpolkit, LibreOffice gtk3); only recommended",
  "alsa-ucm-conf": "R1: laptop sound cards under PipeWire (recommended by libasound2-data)",
  "alsa-topology-conf": "R1: as alsa-ucm-conf"
 },
