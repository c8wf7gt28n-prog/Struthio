+EXPECTED = {'additive': True, 'constant_capacity': True, 'interval_semantics': 'HALF_OPEN',
+            'overhead': 'NONE', 'fragmentation': 'NOT_APPLICABLE', 'indivisibility': 'NOT_APPLICABLE'}   # checked_methods.EXPECTED
