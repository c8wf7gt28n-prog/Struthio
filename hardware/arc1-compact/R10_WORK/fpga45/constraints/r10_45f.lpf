# ARC-1 R10 45F graphics FPGA -- RGMII to D213 GMAC0 (decision D1). Pins reuse the R8.5-C 45F bank-0 RGMII plan
# (R85C_WORK/fpga_ecp5/constraints/arc1_ecp5_r85.lpf, CABGA381); the peer is now D213 PE0-PE15 instead of F133 PG.
SYSCONFIG SLAVE_SPI_PORT=DISABLE CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=2.4 ;
FREQUENCY PORT "clk_25m" 25.000000 MHZ ;
FREQUENCY PORT "rgmii_rxc" 125.000000 MHZ ;  # RGMII receive clock (F133 TXCK); eth_txclk is derived from the PLL
LOCATE COMP "led" SITE "A7" ;  # FPGA_LED0, bank 0
LOCATE COMP "rgmii_rxd[1]" SITE "B9" ;  # ETH_TXD1, bank 0
LOCATE COMP "rgmii_rxc" SITE "B11" ;  # ETH_TXCK, bank 0
LOCATE COMP "rgmii_tx_ctl" SITE "C7" ;  # ETH_RXCTL_E, bank 0
LOCATE COMP "rgmii_txc" SITE "C8" ;  # ETH_RXCK_E, bank 0
LOCATE COMP "rgmii_rxd[2]" SITE "C9" ;  # ETH_TXD2, bank 0
LOCATE COMP "rgmii_rxd[0]" SITE "C10" ;  # ETH_TXD0, bank 0
LOCATE COMP "rgmii_txd[2]" SITE "D8" ;  # ETH_RXD2_E, bank 0
LOCATE COMP "rgmii_txd[0]" SITE "D9" ;  # ETH_RXD0_E, bank 0
LOCATE COMP "rgmii_rxd[3]" SITE "D10" ;  # ETH_TXD3, bank 0
LOCATE COMP "rgmii_txd[3]" SITE "E8" ;  # ETH_RXD3_E, bank 0
LOCATE COMP "rgmii_txd[1]" SITE "E9" ;  # ETH_RXD1_E, bank 0
LOCATE COMP "rgmii_rx_ctl" SITE "E10" ;  # ETH_TXCTL, bank 0
LOCATE COMP "clk_25m" SITE "P3" ;  # FPGA_OSC_25M, bank 6
IOBUF PORT "led" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txc" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "clk_25m" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
