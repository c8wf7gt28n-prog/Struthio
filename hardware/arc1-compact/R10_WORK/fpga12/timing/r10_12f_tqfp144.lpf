# R10 fpga12 constraints. Ports keyed to LFE5U-12F TQFP144 pins (Lattice ECP5U-12 pinout rev 2.1, Feb 2026).
# nextpnr-ecp5/Project Trellis have no TQFP144 package: the *_proxy256.lpf variant locates the SAME PIO sites
# through their caBGA256 balls (same die, same IOLOGIC/clock routing); package parasitics are not modelled by
# nextpnr in either case. Pin-locked TQFP144 P&R needs Lattice Diamond/Radiant (NOT_RUN here).
FREQUENCY PORT "clk_25m" 25.000000 MHZ ;
FREQUENCY PORT "rgmii_rxc" 125.000000 MHZ ;
# LOCATE COMP "clk_25m" SITE "37" ;  # TQFP144 pin 37 = PL47C (LLC_GPLL0T_IN, bank 6)
# LOCATE COMP "rgmii_rxc" SITE "128" ;  # TQFP144 pin 128 = PT29A (PCLKT0_0, bank 0)
# LOCATE COMP "rgmii_rxd[0]" SITE "133" ;  # TQFP144 pin 133 = PT15B (bank 0)
# LOCATE COMP "rgmii_rxd[1]" SITE "134" ;  # TQFP144 pin 134 = PT15A (bank 0)
# LOCATE COMP "rgmii_rxd[2]" SITE "135" ;  # TQFP144 pin 135 = PT13B (bank 0)
# LOCATE COMP "rgmii_rxd[3]" SITE "136" ;  # TQFP144 pin 136 = PT13A (bank 0)
# LOCATE COMP "rgmii_rx_ctl" SITE "139" ;  # TQFP144 pin 139 = PT9B (bank 0)
# LOCATE COMP "rgmii_txc" SITE "110" ;  # TQFP144 pin 110 = PT67A (bank 1)
# LOCATE COMP "rgmii_txd[0]" SITE "111" ;  # TQFP144 pin 111 = PT62B (bank 1)
# LOCATE COMP "rgmii_txd[1]" SITE "112" ;  # TQFP144 pin 112 = PT62A (bank 1)
# LOCATE COMP "rgmii_txd[2]" SITE "113" ;  # TQFP144 pin 113 = PT60B (bank 1)
# LOCATE COMP "rgmii_txd[3]" SITE "114" ;  # TQFP144 pin 114 = PT60A (bank 1)
# LOCATE COMP "rgmii_tx_ctl" SITE "115" ;  # TQFP144 pin 115 = PT58B (bank 1)
# LOCATE COMP "led" SITE "121" ;  # TQFP144 pin 121 = PT51A (bank 1)
# LOCATE COMP "irq_n" SITE "124" ;  # TQFP144 pin 124 = PT42B (bank 1)
IOBUF PORT "clk_25m" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "rgmii_txc" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "led" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "irq_n" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
