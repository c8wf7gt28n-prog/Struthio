# R8.5-C PROVISIONAL (C2 routed-timing study): R8.5 generated LPF + RGMII on bank 0. Hand-written; C3 moves these
# balls into board/r85_board_plan.json and the generator, which must reproduce them. ASSUMPTION until C3.
# LFE5U-45F-6BG381C (caBGA381). Every bank VCCIO = 3V3_FPGA (3.3 V) -> LVCMOS33.
# sysCONFIG: slave SPI (CFG[2:0]=001 strapped on the board); SLAVE_SPI_PORT=DISABLE makes D0/D1/SN/D7 user I/O
# after DONE (TN-02039 Table 7.1). CCLK (U3) is dedicated and carries the same board net as spi_sck (R1).
SYSCONFIG SLAVE_SPI_PORT=DISABLE CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=2.4 ;
FREQUENCY PORT "clk_25m" 25.000000 MHZ ;
LOCATE COMP "led" SITE "A7" ;  # FPGA_LED0, bank 0
LOCATE COMP "dbg_tx" SITE "A8" ;  # FPGA_DBG_TX, bank 0
LOCATE COMP "dbg_rx" SITE "B8" ;  # FPGA_DBG_RX, bank 0
LOCATE COMP "irq_n" SITE "E6" ;  # FPGA_IRQ_N, bank 0
LOCATE COMP "psram_ce_n" SITE "L1" ;  # PSRAM_CE_N, bank 6
LOCATE COMP "psram_sclk" SITE "L2" ;  # PSRAM_SCLK_F, bank 6
LOCATE COMP "psram_sio[0]" SITE "L3" ;  # PSRAM_SIO0, bank 6
LOCATE COMP "psram_sio[1]" SITE "M1" ;  # PSRAM_SIO1, bank 6
LOCATE COMP "psram_sio[2]" SITE "M3" ;  # PSRAM_SIO2, bank 6
LOCATE COMP "psram_sio[3]" SITE "M4" ;  # PSRAM_SIO3, bank 6
LOCATE COMP "psram_pg" SITE "N1" ;  # PSRAM_PG, bank 6
LOCATE COMP "psram_pwr_en" SITE "N2" ;  # PSRAM_EN, bank 6
LOCATE COMP "clk_25m" SITE "P3" ;  # FPGA_OSC_25M, bank 6
LOCATE COMP "spi_sck" SITE "R1" ;  # FPGA_SCK, bank 8
LOCATE COMP "spi_cs_n" SITE "T2" ;  # FPGA_SS_N, bank 8
LOCATE COMP "spi_miso" SITE "V2" ;  # FPGA_MISO, bank 8
LOCATE COMP "spi_mosi" SITE "W2" ;  # FPGA_MOSI, bank 8
IOBUF PORT "led" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "dbg_tx" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "dbg_rx" IO_TYPE=LVCMOS33 PULLMODE=UP ;
IOBUF PORT "irq_n" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "psram_ce_n" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_sclk" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_sio[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_sio[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_sio[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_sio[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST ;
IOBUF PORT "psram_pg" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "psram_pwr_en" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "clk_25m" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "spi_sck" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "spi_miso" IO_TYPE=LVCMOS33 PULLMODE=DOWN SLEWRATE=FAST ;
IOBUF PORT "spi_mosi" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
# RGMII (F133 EMAC PG0..PG12) on bank 0 (top, hot-socket tolerant). rgmii_rxc on PCLKT0_0 (primary clock input).
FREQUENCY PORT "rgmii_rxc" 125.000000 MHZ ;
LOCATE COMP "rgmii_rxc" SITE "B11" ;
LOCATE COMP "rgmii_rxd[0]" SITE "C10" ;
LOCATE COMP "rgmii_rxd[1]" SITE "B9" ;
LOCATE COMP "rgmii_rxd[2]" SITE "C9" ;
LOCATE COMP "rgmii_rxd[3]" SITE "D10" ;
LOCATE COMP "rgmii_rx_ctl" SITE "E10" ;
LOCATE COMP "rgmii_txc" SITE "C8" ;
LOCATE COMP "rgmii_txd[0]" SITE "D9" ;
LOCATE COMP "rgmii_txd[1]" SITE "E9" ;
LOCATE COMP "rgmii_txd[2]" SITE "D8" ;
LOCATE COMP "rgmii_txd[3]" SITE "E8" ;
LOCATE COMP "rgmii_tx_ctl" SITE "C7" ;
IOBUF PORT "rgmii_rxc" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "rgmii_txc" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
IOBUF PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=FAST DRIVE=8 ;
