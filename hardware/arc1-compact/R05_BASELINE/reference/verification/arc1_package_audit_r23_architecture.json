  "findings": [
    {
      "id": "R23-AF01",
      "title": "Resolve the BT memory candidate discrepancy",
      "message": "Selected independent pools total 384 MiB. AS4C64M16MD2A-25BIN is 1 Gbit = 128 MiB, making the named candidate installation 448 MiB. Keep the 64 MiB BT target; choose and qualify its exact part or obtain an explicit owner decision.",
      "sourceIds": [
        "R23-AUTHORITY",
        "ALLIANCE-DDR",
        "BT-DS"
      ],
      "gateIds": [
        "G12",
        "G07"
      ]
    },
    {
      "id": "R23-AF02",
      "title": "74.25 MHz clock strategy remains OPEN",
      "message": "AN086 v1.4 documents 38.4 MHz × {13,15} / (2 × divider), divider 1–16. No documented setting produces 74.25 MHz. Nearest is 72 MHz, which would change the standard timing/frame rate. Obtain a vendor-approved 60 Hz strategy without bypassing BT820B.",
      "sourceIds": [
        "BT-PROGRAM",
        "BT-DS",
        "LINUX-MODES"
      ],
      "gateIds": [
        "G02",
        "G12"
      ]
    },
    {
      "id": "R23-AF03",
      "title": "Budget both LVDS boundaries",
      "message": "For RGB24 dual-pixel input, conservatively budget eight T120-A TX data pairs plus two clock pairs. BT outputs also expose two clock pairs; the ITE reference uses a common clock. Pair allocation, odd/even alignment and clock connection need exact-source proof; never tie active clock outputs.",
      "sourceIds": [
        "BT-HARDWARE",
        "T120-PINOUT",
        "ITE-6263"
      ],
      "gateIds": [
        "G02",
        "G08",
        "G12"
      ]
    },
    {
      "id": "R23-AF04",
      "title": "Render locally and measure BT traffic",
      "message": "1080p60 active RGB888 is 373.248 MB/s and RGBA32 is 497.664 MB/s, above the raw 125 MB/s host ceiling. Four hypothetical RGB888 DRAM passes would consume 1492.992 MB/s of the BT x16-800 raw 1600 MB/s; actual pass count, overlays, arbitration and latency remain unmeasured.",
      "sourceIds": [
        "LINUX-MODES",
        "BT-DS",
        "R23-AUTHORITY"
      ],
      "gateIds": [
        "G01",
        "G04",
        "G12"
      ]
    },
    {
      "id": "R23-AF05",
      "title": "Prove capacity separately in each NOR",
      "message": "Each CPU/FPGA has exactly 16 MiB selected NOR capacity. Generated loadable bytes, erase-rounded metadata, boot/rollback layout and part endurance are unknown. The 48 MiB aggregate cannot cover overflow in another device.",
      "sourceIds": [
        "R23-AUTHORITY",
        "STORAGE-REVIEW"
      ],
      "gateIds": [
        "G05",
        "G13"
      ]
    },
    {
      "id": "R23-AF06",
      "title": "Separate cold boot from game personality loading",
      "message": "A and B cold-boot from their own NORs. Study passive/RAM-staged B game loading with exclusive programming ownership, NOR isolation, CRC/fences and independent JTAG recovery. Per-launch NOR rewriting is not the default.",
      "sourceIds": [
        "R23-AUTHORITY",
        "T120-DS",
        "STORAGE-REVIEW"
      ],
      "gateIds": [
        "G03",
        "G05",
        "G13"
      ]
    },
    {
      "id": "R23-AF07",
      "title": "Keep power and lifetime qualification blocking",
      "message": "Regular I4 FPGA core/PLL is nominal 1.2 V. Alliance LPDDR2 needs near-1.8 V VDD1 and near-1.2 V VDD2/CA/Q classes. The preliminary part limits uncontrolled power-offs to 400 over life; current vendor confirmation and controlled shutdown/power-loss qualification remain required.",
      "sourceIds": [
        "T120-DS",
        "ALLIANCE-DDR"
      ],
      "gateIds": [
        "G01",
        "G07",
        "G09",
        "G11",
        "G12"
      ]
    },
    {
      "id": "R23-AF08",
      "title": "Complete the paired resource and host study",
      "message": "The workbook has 96 DDIO and 40 TX/40 RX pairs per F484. Quarantining configuration/DDR-reference candidates leaves 76 DDIO; this is not a net allocation. DDR startup PLL/ref, RGMII pinmux/fixed-link driver integration, SPI rescue and native-LVDS A/B alternatives need whole-system Efinity and bench evidence.",
      "sourceIds": [
        "T120-PINOUT",
        "T120-DS",
        "HOST-S02",
        "HOST-S03"
      ],
      "gateIds": [
        "G01",
        "G03",
        "G04",
        "G08"
      ]
    },
    {
      "id": "R23-AF09",
      "title": "Assign control, assets and audio explicitly",
      "message": "BT SPI/QSPI control master is OPEN; its raw QSPI ceiling is 30 MB/s and is not automatic access to FPGA RAM. BT I²S is transmit-slave and requires an external BCLK/LRCLK master. SDK, asset transfers, sound source, EDID/HPD/DDC and bridge control need explicit ownership.",
      "sourceIds": [
        "BT-DS",
        "BT-PROGRAM",
        "R23-AUTHORITY"
      ],
      "gateIds": [
        "G02",
        "G10",
        "G12"
      ]
    },
    {
      "id": "R23-AF10",
      "title": "Qualify the separate SPI NAND game library",
      "message": "NAND model/capacity, ECC/OOB/bad-block handling, wear leveling, power-loss-safe updates and exact F133 BSP/controller support are OPEN. Generic Linux support is a candidate path, not a tested console driver. No eMMC substitution.",
      "sourceIds": [
        "R23-AUTHORITY",
        "STORAGE-REVIEW"
      ],
      "gateIds": [
        "G05",
        "G14"
      ]
    }
  ]
}
